<log4net>
	<appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender" >
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%ndc] - %message%newline" />
		</layout>
	</appender>
	<appender name="TraceAppender" type="log4net.Appender.TraceAppender">
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
		</layout>
	</appender>
	<appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
		<file value="log.txt" />
		<appendToFile value="true" />
		<rollingStyle value="Size" />
		<maxSizeRollBackups value="10" />
		<maximumFileSize value="12000KB" />
		<staticLogFileName value="true" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date [%thread] %-5level %logger [%property{NDC}] - %message%newline" />
		</layout>
	</appender>
	<appender name="SmtpAppender" type="log4net.Appender.SmtpAppender">
		<to value="koshevarov@ir-tech.ru" />
		<from value="netcity.synchronize@ir-tech.ru" />
		<subject value="NetCity Synchronization Notification" />
		<!--<smtpHost value="mail.ir-tech.ru" />
		<authentication value="Basic" />
		<port value="25" />
		<username value="user name" />
		<password value="password" />-->
		<bufferSize value="512" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%newline%date %message%newline%newline%newline" />
		</layout>
	</appender>
	<root>
		<level value="ALL" />
		<appender-ref ref="TraceAppender" />
		<appender-ref ref="RollingFileAppender" />
	</root>
	<logger name="DAO">
		<level value="ERROR" />
	</logger>
	<logger name="MailNotifier">
		<level value="ALL" />
		<appender-ref ref="SmtpAppender" />
	</logger>
</log4net>