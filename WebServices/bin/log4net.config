<?xml version="1.0"?>
<log4net>
	<appender name="File" type="log4net.Appender.RollingFileAppender">
		<file type="log4net.Util.PatternString" value="Logs\log.txt"/>
		<appendToFile value="true"/>
		<rollingStyle value="Size"/>
		<maxSizeRollBackups value="10"/>
		<maximumFileSize value="1000KB"/>
		<staticLogFileName value="true"/>
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="%date %-5level %logger - %message%newline"/>
		</layout>
	</appender>
	<appender name="WSRRLogFileAppender" type="log4net.Appender.RollingFileAppender, log4net">
		<file value="Logs\WSRRLogs.log" />
		<appendToFile value="true" />
		<rollingStyle value="Composite" />
		<datePattern value="yyyyMMdd" />
		<maxSizeRollBackups value="-1" />
		<maximumFileSize value="5MB" />
		<countDirection value="1" />
		<staticLogFileName value="true" />
		<layout type="log4net.Layout.PatternLayout, log4net">
			<param name="ConversionPattern" value="%date [%thread] %-5level %-10identity %-10username %-10logger - %message%newline" />
		</layout>
	</appender>
	<appender name="SmtpLogSend" type="NetCity.WebServices.ImportExportService.LoggerAppender.CustomSmtpAppender">
		<to value="integration@ir-tech.ru" />
		<from value="integration@ir-tech.ru" />
		<subject value="Integration logs" />
		
		<smtpHost value="mail.ir-tech.ru" />
		<port value="25" />
		<EnableSsl value="false" />	

		<filter type="log4net.Filter.LevelMatchFilter">
			<levelToMatch value="ERROR" />
		</filter>
		<filter type="log4net.Filter.LevelMatchFilter">
			<levelToMatch value="FATAL" />
		</filter>

		<filter type="log4net.Filter.DenyAllFilter" />
		
		<bufferSize value="1024" />
		<lossy value="false" />
		<evaluator type="log4net.Core.LevelEvaluator,log4net">
			<threshold value="FATAL" />
			<threshold value="ERROR" />
		</evaluator>
		<layout type="log4net.Layout.PatternLayout,log4net">
			<!--<conversionPattern value="%newline%date [%thread] %-5level %logger [%property{NDC}] - %message%newline%newline%newline" /> -->
			<conversionPattern value="%property{log4net:HostName} :: %level :: %message %newlineLogger: %logger%newlineThread: %thread%newlineDate: %date%newlineNDC: %property{NDC}%newline%newline" />
		</layout>
	</appender>	
	<root>
		<priority value="ERROR" />
		<appender-ref ref="File" />
	</root>
	<logger name="NetCity.IntegrationServices">
		<level value="ALL" />
	</logger>
	<logger name="ESIntegrationServices">
		<level value="ALL" />
		<appender-ref ref="SmtpLogSend" />
	</logger>	
	<!-- Specify the level for some specific namespaces -->
	<!-- Level can be : ALL, DEBUG, INFO, WARN, ERROR, FATAL, OFF -->
	<logger name="TepmWCFLogger">
		<level value="ALL" />
		<appender-ref ref="WSRRLogFileAppender" />
	</logger>
</log4net>