class State
	constructor: (@id, @title) ->
		@defaultState = false
		@container = $("#state-" + @id)
		@active = false
	
	setOnEnter: (handler) ->
		@onEnter = handler
		return this

	setHelpPage: (helpPage) ->
		@helpPage = helpPage
		return this

	setOnFail: (handler) ->
		@onFail = handler
		return this

	setOnExit: (handler) ->
		@onExit = handler
		return this

	setDefault: () ->
		@defaultState = true
		return this

	show: (args) ->
		deferr = $.Deferred()
		promise = deferr.promise()

		if @active
			return promise

		@active	= true
		@container.removeClass "hide"

		if @onEnter
			promise = @onEnter(args)
		else 
			deferr.resolve()

		promise.then () =>
			window.ShowHelp = () => 
				openPopupWindow("_help", @helpPage, 950, 660)
		return promise

	hide: () ->
		if not @active
			return
		@container.addClass "hide"
		if @onExit
			@onExit()
		setTimeout (() => @container.find('.state-content').empty()), 200
		@active	= false

class StateManager
	constructor: () ->
		@states = []
		@currentState = null
		@prevState = null

	defineState: (state) ->
		@states.push state

	setState: (id, args) ->
		checkForChanges().then () =>
			window.dataWereChanged = false
			
			state = _.findWhere @states, id: id

			if not state
				throw "unknown state"

			_.each @states, (s) -> s.hide()

			state.show(args).fail () -> if state.onFail then do state.onFail

			@prevState = @currentState
			@currentState = state

			if state.defaultState
				$("a.back").off("click").addClass("active")
				$("h1.title").html state.title
			else
				defaultState = _.findWhere @states, defaultState: true
				breadCrumb = $("<a></a>").attr("href", "#").click(() => @setState(defaultState.id)).html(defaultState.title)
				$("h1.title").empty()
				$("h1.title").append(breadCrumb).append(" / " + state.title)

				$("a.back").off("click").removeClass("active")
				$("a.back").click () => @setState @prevState.id

#для поддержки js модульности
module.exports = {State, StateManager}


