class userInfoAccessJournalCtrl

	constructor: (@params) ->
		@userId =  @params.editedUserId
		@loader = new UserInfoAccessJournalLoader()
		@tplManager = new TemplatesManager()
	# private fields and methods


	_showAccessJournalEntryDetails: (entryId) ->
		entryDetails = null
		template = null
		loadDetails = @loader.getDetails(@userId, entryId).then (response) -> entryDetails = response
		templateReady = @tplManager.getDetailsTemplate().then (response) -> template = response

		$.when loadDetails, templateReady
		.then () =>
			if not entryDetails.length
				alert language.Generic.Common.kNoDetails
				return
		
			model = 
				accessJournalEntryDetails: entryDetails
				language: language

			source = Handlebars.compile template
			html = source(model)
		
			$.show.dialog
				title: language.Generic.Common.kDetails,
				message: html,
				size: BootstrapDialog.SIZE_WIDE

	browseAccessJournal: ->
		userId =  @params.editedUserId
		ctrl = this
		journalEntries = null
		template = null

		loadEntries = @loader.getAccessJournal(@params.editedUserId).then (response) => journalEntries = response
		templateReady = @tplManager.getJournalTemplate().then (response) => template = response

		$.when loadEntries, templateReady
		.then () =>
			if not journalEntries.length
				alert language.Generic.Common.kNoChangesData
				return
		
			_.map journalEntries, (_obj) -> 
				date = dateUtils.castServerDateTimeToClient(_obj.date)
				_obj.date = dateUtils.date2str(date) + ' ' + dateUtils.time2Str_ss(date)
		
			model = 
				accessJournalEntries: journalEntries
				language: language

			
			source = Handlebars.compile template
			html = source(model)

			$.show.dialog
				title: language.Generic.Common.kChangeHistory,
				message: html
				onshown: (dialog) =>
					#добавляем обработчики для показа деталей
					dialog.$modalBody.on "click", "a.link-display-journal-entry-details", (evt) => 
						entryId = $(evt.currentTarget).data("entry-id")
						ctrl._showAccessJournalEntryDetails entryId


class UserInfoAccessJournalLoader 
	getAccessJournal: (userId) ->
		jsSubmit
			action: "/webapi/users/#{userId}/info/accessjournal",
			showProcessing: true,
			method: 'GET'

	getDetails: (userId, entryId) ->
		jsSubmit
			action: "/webapi/users/#{userId}/info/accessjournal/#{ entryId }/details"
			showProcessing: true,
			method: 'GET'

class TemplatesManager
	constructor: () ->
		@cache = {}

	_getTemplate = (url) ->
		def = $.Deferred()

		jsSubmit
			method: 'GET',
			action: url,
			auth: false,
			dataType: 'html',
			contentType: 'text/plain',
			showProcessing: true
		.then (html) -> def.resolve html.replace(/(?:\r\n|\r|\n)/g, '')

		return def.promise()

	
	getDetailsTemplate: () ->
		return _getTemplate('/static/dist/pages/users/templates/userInfoAccessJournalDetails.html');

	getJournalTemplate: () ->
		return _getTemplate('/static/dist/pages/users/templates/userInfoAccessJournal.html');

#для поддержки js модульности
((exp, name) ->
	exported = false
	if module?.exports
		module.exports = exp
		exported = true

	if !(exports is undefined)
		exports = exp
		exported = true

	if !exported and typeof window != 'undefined' and typeof name != "undefined"
		window[name] = exp
		
	if typeof root != 'undefined' and typeof (name) != "undefined"
		root[name] = exp
)(userInfoAccessJournalCtrl)


