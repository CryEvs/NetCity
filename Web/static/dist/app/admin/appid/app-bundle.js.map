'use strict';

angular.module 'irtech.netcity.directive', []
.directive("storage", () ->
	link = (scope, element, attributes) ->
		supportLocalStorage = () ->
			try 
				return window.localStorage && ((typeof window['localStorage']) == 'object')
			catch
				return false

		simpleHash = (str) ->
			hash = 0
			if str.length == 0 
				return hash

			for i in [0...str.length]
				char = str.charCodeAt(i)
				hash = ((hash<<5)-hash)+char
				hash = hash & hash;
			return hash

		id = attributes.ngModel
		url = /^https?:\/\/([^?#]*)/.exec(document.URL)[1]
		# Ключ берётся через хэш функцию, что бы уменьшить вероятность пересечения ключей
		key = "H"+simpleHash(url + "|" + attributes.ngModel)
		#console.log id

		if supportLocalStorage()
			get = () -> localStorage[key]
			set = (value) -> localStorage[key] = value
		else
			get = () -> $.cookie(key);
			set = (value) -> $.cookie(key, value);

		load = () ->
			scope
			value = get()
			if value && "undefined" != value
				eval("scope."+id+"="+value)
		save = () ->
			scope
			value = JSON.stringify(eval("scope."+id))
			set(value)

		load()
		element.on 'change', (event) -> setTimeout save, 1  # Отложить выполнение в конец стека обработчиков
	return (link: link)
)



