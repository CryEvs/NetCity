((angular) ->
	'use strict';

	angular.module 'irtech.netcity.admin.schools'
	.controller 'EditSchoolCtrl', ($scope, $http, $q, $alerts, $dialogs, $uibModalInstance, $longWork, md5, model) ->
		$scope.$parent.pagetitle = "Редактирование образовательных организаций"
		
		schooldefault = 
			cityId: model.city.id,
			educOrganization: {
				foundersIds: []
			}
			department: null
			departmentSchools: null
			districtId: null
			admin: 
				login: "admin"
				pass: "admin"
			name: null
			# вышестоящие УО
			ownEducManagementsIds: []
		
		$.extend $scope,
			language: language
			header: (if model.school == null then "Создание" else "Редактирование") + " образовательной организации"
			ready: false
			
			city: model.city
			settings:
				editing: model.school != null
			references:
				schools: model.schools
				cityDistricts: []
				eoTypes: []
				eoForms: () ->
					if not $scope.school.educOrganization.eoTypeId
						return []
					eoType = _.findWhere $scope.references.eoTypes, 
						id: $scope.school.educOrganization.eoTypeId
					if not eoType
						return []
					
					forms = _.filter eoType.eoForms, (ef) -> ef.funcType > 0
					
					if $scope.settings.editing and not $scope.school.canChangeFuncType
						forms = _.filter forms, (ef) -> ef.funcType == $scope.school.funcType
						
					forms
				funcTypes: []
				eoLegalForms: []
				eoLegalForms83: []
			school: schooldefault

		promises = []

		loadCityRefs = (cityId) ->
			cityPromises = []

			cityPromises.push ( $http.get "/webapi/addresses/cities/#{cityId}/districts"
				.then (response) -> $scope.references.cityDistricts = response.data
			)

			cityPromises.push ( $http.get "/webapi/founders?cityId=#{cityId}"
				.then (response) ->
					$scope.references.founders = response.data
			)

			cityPromises.push ( $http.get "/webapi/educmanagements/hierarchy?cityId=#{cityId}"
				.then (response) ->
					$scope.references.educmanagements = response.data
					processEducmanagements($scope.references.educmanagements)
			)

			return $q.all cityPromises

		
		if model.school == null
			promises.push loadCityRefs($scope.city.id)

		if model.school != null

			promises.push ( $http.get("/webapi/schools/#{model.school.id}")
				.then (response) -> 
					$scope.school = response.data
					if $scope.school.schoolInformation and $scope.school.schoolInformation.foundingDate
						$scope.school.schoolInformation.foundingDateStr = dateUtils.date2str(new Date($scope.school.schoolInformation.foundingDate))
						return
				.then () -> loadCityRefs($scope.school.cityId)
			)

		promises.push ( $http.get "/webapi/references/eoRefs"
			.then (response) ->
				#фильтруем список типов ОУ - оставляем только те, что могут использвоаться 
				$scope.references.eoTypes = _.filter(response.data.types, (et) -> _.some(et.eoForms, (ef) -> ef.funcType > 0) )
				$scope.references.eoLegalForms = response.data.legalForms
				$scope.references.eoLegalForms83 = response.data.legalForms83
				$scope.references.funcTypes = response.data.functionalityTypes
				$scope.references.otrasls = response.data.otrasls
				$scope.references.statusOrganizations = response.data.statusOrganizations
				
				if not $scope.school.schoolInformation
					$scope.school.schoolInformation = {
						statusOrganization: $scope.references.statusOrganizations[0].id
					}
		)

		$q.all promises
			.then ->
				if not $scope.settings.editing
					return
					
				if not $scope.school.canChangeFuncType
					#фильтруем список доступных типов ОО по текущей функциональности организации
					schoolEoType = _.findWhere $scope.references.eoTypes, id: $scope.school.educOrganization.eoTypeId
					schoolEoForm = _.findWhere schoolEoType.eoForms, id: $scope.school.educOrganization.eoFormId
					$scope.school.funcType = schoolEoForm.funcType
					
					$scope.references.eoTypes = _.filter $scope.references.eoTypes, (et) -> 
						_.some et.eoForms, (ef) -> ef.funcType == $scope.school.funcType
				
				if $scope.school.department and $scope.school.department.mainSchoolId
					$http.get("/webapi/schools/#{$scope.school.department.mainSchoolId}/getAddressedName")
						.then (response) ->
							$scope.references.mainSchools = [{
								id: $scope.school.department.mainSchoolId
								name: response.data
							}]
			.then ->
				$scope.ready = true

		$scope.changeType = () ->
			$scope.school.educOrganization.eoFormId = $scope.references.eoForms()[0].id

		$scope.isFounderSelected = (founder) ->
			_.contains $scope.school.educOrganization.foundersIds, founder.id

		$scope.toggleFounder = (founder) ->
			if $scope.isFounderSelected founder
				$scope.school.educOrganization.foundersIds = _.without $scope.school.educOrganization.foundersIds, founder.id
			else
				$scope.school.educOrganization.foundersIds.push founder.id

		$scope.isEducmanagementSelected = (educmanagement) ->
			_.contains $scope.school.ownEducManagementsIds, educmanagement.emId

		$scope.toggleEducmanagement = (educmanagement) ->
			if $scope.isEducmanagementSelected educmanagement
				$scope.school.ownEducManagementsIds = _.without $scope.school.ownEducManagementsIds, educmanagement.emId
			else
				$scope.school.ownEducManagementsIds.push educmanagement.emId

			subOwnEducManagementsIds = _.map _.filter($scope.references.educmanagements, (item) -> item.parentEmId == educmanagement.parentEmId and item.emId != educmanagement.emId), (item) -> item.emId
			_.each subOwnEducManagementsIds, (subOwnEducManagementId) -> $scope.school.ownEducManagementsIds = _.without $scope.school.ownEducManagementsIds, subOwnEducManagementId

		processEducmanagements = (educmanagements) ->
			if not (educmanagements and educmanagements.length) then return

			nodeName = ""
			parentEmId = -1

			_.each educmanagements, (educmanagement) -> 
				if educmanagement.treeLevel == 0 
					nodeName = "educmanagement-" + educmanagement.emId
					parentEmId = educmanagement.emId

				educmanagement.tabs = '\t'.repeat(educmanagement.treeLevel)
				educmanagement.elementName = nodeName
				educmanagement.parentEmId = parentEmId
				return

		validate = () ->
			if !$scope.school.name
				$dialogs.message "Полное наименование не может быть пустым"
				return false
			if !$scope.school.educOrganization.name
				$dialogs.message "Краткое наименование не может быть пустым"
				return false
			if !$scope.school.number
				$dialogs.message "Номер не может быть пустым"
				return false
			if !$scope.school.educOrganization.eoTypeId || !$scope.school.educOrganization.eoFormId
				$dialogs.message "Необходимо выбрать тип ОО"
				return false
			if !$scope.school.educOrganization.eoLegalFormId 
				$dialogs.message "Необходимо выбрать правовую форму"
				return false

			if $scope.school.department && !$scope.school.department.mainSchoolId
				$dialogs.message "Необходимо выбрать основную организацию"
				return false
				
			if !$scope.settings.editing 
				if !$scope.school.admin.login or !$scope.school.admin.pass
					$dialogs.message "Необходимо укзать логин и пароль администратора организации"
					return false
					
			if $scope.school.schoolInformation.foundingDateStr
				if !str2date($scope.school.schoolInformation.foundingDateStr)
					$dialogs.message "Некорректная дата основания"
					return false
			
			return true
			
		$scope.toggleDepartment = ->
			if $scope.school.department is null
				$scope.school.department = {}
			else
				$scope.school.department = null
				
		$scope.refreshMainSchools = (schoolName) ->
			if not schoolName
				return

			searchData = { cityId: $scope.city.id, name: schoolName }
			if $scope.school.id > 0 
				searchData.excludeSchoolId = $scope.school.id

			$scope.references.mainSchools = [{name: 'Поиск...'}]

			$http.get("/webapi/schools/search", {params: searchData})
				.then(
					(response) ->
						if not response.data.length
							$scope.references.mainSchools = [{name: 'Совпадений не найдено'}]
						else
							$scope.references.mainSchools = response.data
					,
					(response) -> $alerts.error response.data.message
				) 
					
		#сохранение
		$scope.ok = () ->
			promise = null
			
			if !validate()
				return
				
			if $scope.school.schoolInformation.foundingDateStr
				$scope.school.schoolInformation.foundingDate = dateUtils.str2date($scope.school.schoolInformation.foundingDateStr)
			else
				$scope.school.schoolInformation.foundingDate = $scope.school.schoolInformation.foundingDateStr
				
			if $scope.settings.editing
				$longWork.execute $http.post("/webapi/schools", $scope.school)
					.then (response) -> 
						$uibModalInstance.close response.data
						$alerts.success language.Generic.ServAdmin.kSchoolInfoWasChanged
					.catch (response) -> $alerts.error response.data.message || response.data.details
			else
				canCreate = true

				if $scope.references.cityDistricts.length and not $scope.school.districtId 
					confirmText = language.Generic.ServAdmin.kMsgSchoolDistict + '\n\t' + language.Generic.Common.kMsgAreYouSure + '\n' + language.Generic.ServAdmin.kMsgBindSchoolWIthRegion
					#todo. исправить в $dialogs.confirm
					canCreate = $dialogs.confirm(confirmText.replace("\n", "<br />"))

				$q.when canCreate 
				.then () ->
					createData = $.extend {}, $scope.school
					createData.admin.pass = md5.createHash createData.admin.pass
					
					$longWork.execute $http.put("/webapi/schools", createData)
						.then (response) -> 
							$uibModalInstance.close response.data
							$alerts.success language.Generic.ServAdmin.kSchoolWasCreated
						.catch (response) -> $alerts.error response.data.message || response.data.details
		#отмена
		$scope.cancel = () ->
			$uibModalInstance.dismiss('cancel')
		
		$scope.browseAccessJournal = ->
			ctrl = require "webroot/vendor/pages/js/browseSchoolInfoAccessJournal.js"
			browseSchoolInfoAccessJournalCtrl = new ctrl({schoolId: $scope.school.id})
			browseSchoolInfoAccessJournalCtrl.browseAccessJournal()
		return
	
	return
)(window.angular)


