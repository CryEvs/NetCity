((angular) ->
	'use strict';

	angular.module 'irtech.netcity.admin.schools'
	.controller 'SchoolsListCtrl', ($scope, $http, $alerts, $uibModal, $longWork, $appLoader) ->
		$scope.$parent.page =
			title: "Список образовательных организаций"

		$.extend $scope,
			viewReady: false
			data: 
				countries: [], country: null
				states: [], state: null
				provinces: [], province: null
				cities: [], city: null
				schools: [], school: null
			
		initFilter = (setlist, setselected, loadFunc, dependentExpression) ->
			handler =  (newVal, oldVal) ->
				if initingFilters 
					return
			
				if newVal is null
					setlist []
					setselected null
					return

				loadFunc newVal
					.then (response) ->
						setlist response.data
						if response.data.length and response.data.length > 0
							setselected response.data[0]
		
			if not angular.isArray dependentExpression
				$scope.$watch dependentExpression, handler
			else
				$scope.$watchGroup dependentExpression, handler

		loader = 
			getStates: (countryId) -> $http.get "/webapi/addresses/countries/#{countryId}/states?withCities=true"
			getProvinces: (stateId) -> $http.get "/webapi/addresses/states/#{stateId}/provinces"
			getCities: (stateId, provinceId) -> 
				if provinceId == -1 
					provinceId = null
				$http.get "/webapi/addresses/states/#{stateId}/cities?provinceId=#{provinceId}&withCities=true"
			getSchools: (cityId) -> $http.get "/webapi/schools/short?cityId=#{cityId}&withHiddenMarks=true"
			
		initingFilters = true
		
		$http.get("/webapi/addresses/init?main=true")
			.then (response) ->
				$scope.data = angular.extend $scope.data, response.data
			.then () ->
				initFilter ((list) -> $scope.data.states = list), ((item) -> $scope.data.state = item), ( (country) -> loader.getStates country.id), 'data.country'
				initFilter ((list) -> $scope.data.provinces = list), ((item) -> $scope.data.province = item), ( (state) -> loader.getProvinces state.id), 'data.state'
				initFilter ((list) -> $scope.data.cities = list), ((item) -> $scope.data.city = item), ( (stateprovince) -> loader.getCities stateprovince[0]?.id, stateprovince[1]?.id), ['data.state', 'data.province']
				initFilter ((list) -> $scope.data.schools = list), ((item) -> $scope.data.school = item), ( (city) -> loader.getSchools city.id), 'data.city'

				loader.getSchools($scope.data.city.id)
					.then (response) ->
						$scope.viewReady = true
						$appLoader.hide()
						$scope.data.schools = response.data
						$scope.data.school = $scope.data.schools[0]
						
				window.setTimeout (() -> initingFilters = false), 1000
			.catch (response) ->
				if response?.data
					$.show.error response.data.message || language.Generic.ServAdmin.kUnknownError
				else
					$.show.error language.Generic.ServAdmin.kUnknownError
				
		$scope.reloadSchools = (selectSchool) ->
			loader.getSchools $scope.data.city.id
				.then (response) ->
					$scope.data.schools = response.data
					if selectSchool
						$scope.data.school = _.findWhere $scope.data.schools, {id: selectSchool.id}

		#удаление ОУ
		$scope.delete = (school) ->
			$longWork.execute $http.get "/webapi/schools/#{school.id}/canDelete"
				.then (response) ->
					if !response.data
						alert language.Generic.ServAdmin.kUnknownError
						return

					if response.data.isWorkInSchool
						alert response.data.message
						return;

					confirms = []
					if response.data.isCommonDataEnter
						confirms.push $.show.getConfirmation(language.Generic.ServAdmin.kAreYouSureToDelSchool_DataEnter)
						confirms.push $.show.getConfirmation(language.Generic.ServAdmin.kAreYouSureToDelSchool2)
						confirms.push $.show.getConfirmation(language.Generic.ServAdmin.kAreYouSureToDelSchool3)
					else
						confirms.push $.show.getConfirmation(language.Generic.ServAdmin.kAreYouSureToDelSchool)
						confirms.push $.show.getConfirmation(language.Generic.ServAdmin.kAreYouSureToDelSchool2)
						
					extDeferred.when(confirms)
				.then () ->
					$longWork.execute $http.delete "/webapi/schools/#{school.id}"
					.then( (response) -> 
							alert "Образовательная организация успешно удалена"
							$scope.data.schools = _.reject $scope.data.schools, (s) -> s.id == school.id
						(response) -> 
							$.show.error response.data.message || response.data.details
				)

		#импорт
		$scope.import = () ->

			cityId = $scope.data.city.id
			districtId = -1
			
			$http.get("/static/dist/app/admin/schools/list/import.html")
			.then (response) ->
				template = response.data
				$.show.fileDialog
					title: language.Generic.Buttons.kImportOU
					isAjax: true
					submitParams: { cityId: cityId, districtId: districtId }
					fileExts: ['.xls']
					url: "/asp/Administration/SchoolsImport.asp",
					handlerAjaxSuccess: (response) ->
						if response.IsError
							$.show.error response.data.message
							return
						
						model = 
							data: response.data
							language: language
							showDistricts: _.some response.data.schoolList, (school) -> school.DistrictName and school.DistrictName.length
							showProvinces: _.some response.data.schoolList, (school) -> school.ProvinceName and school.ProvinceName.length
							showComments: _.some response.data.schoolList, (school) -> school.Comment and school.Comment.length
							showEOForm: _.some response.data.schoolList, (school) -> school.FormName and school.FormName.length
						
						importUnavailable = !_.some response.data.schoolList, (school) -> school.CanImport
						
						source = template.replace(/(?:\r\n|\r|\n)/g, '')
						template = Handlebars.compile(source)
						
						html = template model
						
						buttons = [
							{
								label: language.Generic.Import.kBeginImport
								cssClass: "btn-primary"
								action: (dialog) ->
									selectedSchools = $("input[name='incEO']:checkbox:checked")

									if selectedSchools.length == 0
										alert language.Generic.ServAdmin.kMustSelectEO
										return

									data =
										incEO: []

									selectedSchools.each () -> data.incEO.push this.value

									jsSubmit
										data: data
										action: "/asp/Administration/SchoolsImportSave.asp"
										showProcessing: true
									.then (response) ->
										dialog.close()
										$scope.reloadSchools()
										
										model = response.data.result
										
										$http.get("/static/dist/app/admin/schools/list/import-completed.html")
										.then (response) ->
											template = response.data
											
											source = template.replace(/(?:\r\n|\r|\n)/g, '')
											template = Handlebars.compile(source)
											html = template
												model: model
												language: language

											$.show.dialog
												title: language.Generic.Import.kTitleImportEO
												size: BootstrapDialog.SIZE_WIDE
												message: html
												buttons: [
													label: language.Generic.Calendar.kClose
													action: (dialog) -> dialog.close()
												]
							}, {
								label: language.Generic.Common.kCheckAll
								action: (dialog) ->
									$('input[name="incEO"]:enabled:checkbox', document.MainForm).prop('checked', true)
							}, {
								label: language.Generic.Common.kUnCheckAll
								action: (dialog) ->
									$('input[name="incEO"]:enabled:checkbox', document.MainForm).prop('checked', false)
							}
						]

						if importUnavailable
							buttons = []

						$.show.dialog
							title: language.Generic.Import.kTitleImportEO
							size: BootstrapDialog.SIZE_WIDE
							message: html
							buttons: buttons

		#администрирование
		$scope.admin = () ->
			modalInstance = $uibModal.open
				templateUrl: '/static/dist/app/admin/schools/adminllist/template.html'
				controller: 'AdminListCtrl'
				controllerAs: "ctrl"
				resolve:
					school: -> $scope.data.school

		#редактировать
		$scope.edit = (school) ->
			modalInstance = $uibModal.open
				templateUrl: '/static/dist/app/admin/schools/edit/template.html'
				controller: 'EditSchoolCtrl'
				size: "lg"
				resolve:
					model: ->
						schools: $scope.data.schools
						school: school
						city: $scope.data.city
						
			modalInstance.rendered.then( -> dateInput.initDateInputs())
						
			modalInstance.result
				.then (editedSchool) -> 
					school = _.findWhere $scope.data.schools, {id: editedSchool.id}
					school.name = editedSchool.educOrganization.name
					if editedSchool.hidden
						school.name = "(-) " + school.name

		#добавить
		$scope.add = () ->
			modalInstance = $uibModal.open
				templateUrl: '/static/dist/app/admin/schools/edit/template.html'
				controller: 'EditSchoolCtrl'
				size: "lg"
				resolve:
					model: ->
						schools: $scope.data.schools
						school: null
						city: $scope.data.city
			
			modalInstance.rendered.then( -> dateInput.initDateInputs())
						
			modalInstance.result.then (createdSchool) -> $scope.reloadSchools createdSchool
		return

	return
)(window.angular)


