# CoffeeScript
((angular) ->
	#'use strict';

	angular.module 'irtech.netcity.school.summerbusy'
	.controller 'SummerBusyController', ($scope, $http, $alerts, $longWork, $dialogs, $q) ->
		$scope.$parent.page = {
			parent: {
				title: "Ученики",
				href: "/asp/SetupSchool/Students.asp"
			},
			title: "Летняя занятость"
		}

		$.extend $scope,
			readonly: true
			viewReady: false
			tableReady: false
			filterWork: false
			globalYears:[]
			months:[
				(id: -1, name: "Все", selected: false, errors: [])
				#(id: 5, name: "Май", selected: false, errors: [])
				(id: 6, name: "Июнь", selected: false, errors: [])
				(id: 7, name: "Июль", selected: false, errors: [])
				(id: 8, name: "Август", selected: false, errors: [])
			]
			hasData: false
			urls:
				busyinfo: "/webapi/summer/busyinfo"
				busyforms: "/webapi/summer/busyForms"
				schoolGlobalYears: "/webapi/summer/getYears"
				classes: "/webapi/summer/getClasses"
				readWriteRight: "/webapi/summer/getReadWriteRights"

		http = 
			get: (request, positiveHandler, catcherHandler) ->
				if(!catcherHandler)
					catcherHandler = defaultErrorCatcher
				return $http.get(request).then(positiveHandler, catcherHandler)
			post: (request, postData, positiveHandler, catcherHandler) ->
				if(!catcherHandler)
					catcherHandler = defaultErrorCatcher
				return $http.post(request, postData).then(positiveHandler, catcherHandler)

		requests =
			getChildsBusy: (globalYearId, monthNum, classId = null) -> 
				handler = (response) ->
					num = 1
					$scope.data = _.chain(response.data)
						.groupBy( (o) -> o.student.id )
						.map mapGroupBusy
						.sortBy (o) -> o.student.name
						.each (o) -> o.id = num++
						.each $scope.checkRow
						.value()
					$scope.hasData = _.some($scope.data)
					$scope.globalYear = _.findWhere($scope.globalYears, id: globalYearId)
					$scope.class = _.findWhere($scope.classes, id: classId)
					$scope.globalYear_filter = $scope.globalYear
					$scope.class_filter = $scope.class
				request = $scope.urls.busyinfo + "?globalYearId=#{globalYearId}&monthNum=#{monthNum}&classId=#{classId}"
				http.get(request, handler)

			saveChildsBusy: (globalYearId, monthNum, classId = null) -> 
				
				dataNotComplete = _.chain($scope.months).pluck("errors").flatten().some().value()
				if dataNotComplete
					$dialogs.notify "Форма должна быть заполнена полностью", "Нельзя сохранить, пока не будет заполнена информация для всех детей за весь летний период"
					return {then: (a,b)->{}} #Заглушка 

				request = $scope.urls.busyinfo + "?globalYearId=#{globalYearId}&monthNum=#{monthNum}&classId=#{classId}"
				return http.post(request, inverseMap(monthNum), (response) -> $dialogs.message "Информация о летней занятости успешно сохранена")

			getBusyTypes: () -> 
				http.get($scope.urls.busyforms, (response) -> $scope.busyForms = response.data)

			getGlobalYears: () -> 
				handler = (response) ->
					$scope.globalYears = response.data
					if !$scope.globalYear_filter
						$scope.globalYear_filter = _.first(response.data)
				http.get($scope.urls.schoolGlobalYears, handler)

			getClasses: () ->
				handler = (response) ->
					$scope.classes = response.data

					if !$scope.class_filter || !_.chain(response.data).pluck('id').contains($scope.class_filter && $scope.class_filter.id).value()
						$scope.class_filter = _.first(response.data)

				globalYearId = $scope.globalYear_filter.id
				request = $scope.urls.classes + "?globalYearId=#{globalYearId}" 
				http.get(request, handler)

			getReadWriteRights: () -> 
				$scope.globalYear = $scope.globalYear_filter
				$scope.class = $scope.class_filter
				globalYearId = $scope.globalYear.id
				request = $scope.urls.readWriteRight + "?globalYearId=#{globalYearId}"
				http.get(request, (response) -> $scope.readonly = response.data)
	
		defaultErrorCatcher = (response) ->
			if response?.data
				$.show.error response.data.message || language.Generic.Common.kErrorMsg
			else
				$.show.error language.Generic.Common.kErrorMsg

		mapGroupBusy = (groupBusy, student) ->
			allMonths = _.chain($scope.months).filter((m) -> m.id > 0).pluck('id').value()
			mapSubGroup = (subgroup) ->
				result = []
				for busyform in $scope.busyForms
					if not _.contains(allMonths, subgroup.monthNum)
						return

					result.push (
						id: busyform.id
						name: busyform.name
						checked: _.contains(subgroup.busyForms, busyform.id) || (busyform.id == 256 && subgroup.busyFormDescription && subgroup.busyFormDescription.length > 0)
						monthNum: subgroup.monthNum
						busyFormDescription: subgroup.busyFormDescription
						trackNumber: student + '_' + subgroup.monthNum + '_' + busyform.id
						#value: ""
						)
				return result

			# Добавить недостающие месяца
			allMonths = $scope.getAllMonths()
			existsMonths = _.chain(groupBusy).pluck('monthNum').intersection(allMonths).value()
			missingMonths = _.chain(allMonths).difference(existsMonths).value()

			for month in missingMonths
				missingGroupBusy = _.extend(new Object(), groupBusy[0])
				missingGroupBusy.busyForms = []
				missingGroupBusy.busyFormDescription = ''
				missingGroupBusy.monthNum = month
				groupBusy.push(missingGroupBusy)

			busy = []
			for group in groupBusy
				for element in mapSubGroup(group)
					busy.push(element) 

			busy = _.sortBy busy, (o) ->
					orderNum = [128, 1, 2, 4, 8, 16, 32, 64, 256]
					busyLevel = orderNum.indexOf(o.id)
					# Сортировка сначала по месяцу, затем по id флага
					return o.monthNum + busyLevel / orderNum.length

			return (
				student: groupBusy[0].student
				globalYearId: groupBusy[0].globalYearId
				busy: busy
				errors: []
				)

		inverseMap = (monthNum) ->
			# Todo отфильтровать по месяцу если он есть
			getCheckedForms = (busy) -> _.chain(busy).where(checked:true).map( (busy) -> busy.id ).value()
			getDescription = (busy) -> _.chain(busy).findWhere(id: 256).value().busyFormDescription
			
			result = []
			
			for data in $scope.data
				groupedBusy =  _.chain(data.busy).groupBy((o) -> o.monthNum).value()
				for monthNum of groupedBusy
					result.push
						student: data.student
						globalYearId: $scope.globalYear.id
						monthNum: monthNum
						busyForms: getCheckedForms(groupedBusy[monthNum])
						BusyFormDescription: getDescription(groupedBusy[monthNum])
			return result

		getChildsBusy = (monthnum, classId) ->
			requests.getChildsBusy $scope.globalYear.id, monthnum, $scope.class.id

		$scope.applyFilters = () ->
			checkChanges () -> 
				$scope.tableReady = false
				$scope.filterWork = true
				$scope.readonly = true

				_.each($scope.months, (o) -> o.errors = [])

				requests.getReadWriteRights()
				.then () ->
					getChildsBusy(null,null)
					.then () ->
						window.dataWereChanged = false
						$scope.filterWork = false
						$scope.tableReady = true

		$scope.getClasses = () -> requests.getClasses()

		$scope.getAllMonths = () -> return _.chain($scope.months).filter((o) -> (o.id > 0)).pluck('id').value()

		$scope.checkRow = (row) ->
			allMonths = $scope.getAllMonths()
			row.hasNotChoise = not _.chain(row.busy)
				.filter((b) -> _.contains(allMonths, b.monthNum))
				.pluck('checked').some().value()

			if(row.hasNotChoise)
				_.chain($scope.months)
					.each((m) -> m.errors = _.without(m.errors, row.id))
					.each((m) -> m.hasErrors = _.some(m.errors))
					.value()
				row.errors = []
				row.hasErrors = false
				return

			rowMonths = _.chain(row.busy).where({checked:true}).pluck('monthNum').intersection(allMonths).value()
			diff = _.chain(allMonths).difference(rowMonths).value()
			_.chain($scope.months)
				.each (m) -> 
					if _.contains(diff, m.id)
						m.errors.push(row.id)
					else
						m.errors = _.without(m.errors, row.id)
				.each((m) -> m.hasErrors = _.some(m.errors))
				.value()
			row.errors = diff
			row.hasErrors = _.some(diff)
			window.dataWereChanged = true

		$scope.changeOther = (busy) ->
			busy.checked = busy.busyFormDescription.length > 0
				
		$scope.save = () ->
			requests.saveChildsBusy $scope.globalYear.id, null, $scope.class.id
				.then window.dataWereChanged = false

		$scope.cancel = () ->
			$scope.applyFilters()

		checkChanges = (handler) ->
			checkForChanges().done(handler)

		$scope.selectMonth = (month) -> 
			$scope.month.selected = false
			$scope.month = month
			$scope.month.selected = true
			_.chain($scope.data)
				.each($scope.checkRow)
				.value()

		#Добавлено чтобы функции были в области видимости всплывающей панели кнопок 
		document.global = 
			applyFilters: $scope.applyFilters
			saveButton: $scope.save
			cancelButton: $scope.cancel

		$scope.month = _.first($scope.months)
		$scope.month.selected = true

		jobs = []
		jobs.push requests.getGlobalYears().then () -> requests.getClasses()
		jobs.push(requests.getBusyTypes())
		
		$q.all(jobs)
			.then () -> 
				$scope.viewReady = true
				#$scope.tableReady = true
)(window.angular)


