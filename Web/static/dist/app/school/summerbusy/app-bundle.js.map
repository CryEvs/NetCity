module = angular.module 'irtech.netcity.school.summerbusy', 
	[
		'ngRoute', 'ngSanitize', 'ngMessages', 'ui.select', 'uikit.alerts', 'uikit.dialogs', 
		'ui.bootstrap', 'irtech.netcity.directive', 'ui.bootstrap.tooltip', 
		'irtech.netcity.ui-components'
	]

require("./summerBusyController.coffee");
require("approot/global/directives/storageDirective.coffee");

module
	.filter 'propsFilter', ->
		(items, props) ->
			out = []

			if angular.isArray(items)
				items.forEach (item) ->
					itemMatches = false

					keys = Object.keys(props)
					for prop in keys
						text = props[prop].toLowerCase()
						if item[prop].toString().toLowerCase().indexOf(text) != -1
							itemMatches = true;
							break

					if itemMatches
					  out.push(item)
			else
			  out = items
			return out
	
	.controller 'NetCityController', ($scope, $route, $routeParams, $location) ->
		$scope.$route = $route;
		$scope.$location = $location;
		$scope.$routeParams = $routeParams;
		return

	.config ($routeProvider, $locationProvider) ->
		$routeProvider
			.otherwise
				redirectTo: '/'
				templateUrl: '/static/dist/app/school/summerbusy/template.html'
				controller: 'SummerBusyController'

	.run ($rootScope, $http) ->
		#обработка маршрутизации

		$rootScope.$on '$routeChangeError', (event) ->
			console.log "$routeChangeError"
			event.preventDefault()
		
		$http.defaults.withCredentials = true
		$http.defaults.headers.common['at'] = strATTok

		#запрещает перезагрузку страницы
		
		document.onkeydown = (e) ->
			postTo '/angular/school/summerbusy/' if e.key is 'F5' or e.keyCode is 116 or (e.key is 'r' or e.key is 'R' or e.keyCode is 82) and e.ctrlKey



