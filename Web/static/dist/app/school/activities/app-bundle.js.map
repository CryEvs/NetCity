# CoffeeScript
((angular) ->
	#'use strict';

	angular.module 'irtech.netcity.school.activities'
	.controller 'learningApplicationsController', ($scope, $http, $q, $appLoader) ->

		$scope.$parent.page =
			title: language.Generic.MenuFolders.kFNLearningApplications

		$scope.language = language
		$scope.ready = false
		$scope.rights ={}
		$scope.uploadLimit = 65535
		$scope.ciform = 
			kLAImport1: language.Generic.LearnApp.kLAImport1
			kLAImport2: language.Generic.LearnApp.kLAImport2
			kLAImport3: language.Generic.LearnApp.kLAImport3
			kLAImport4: language.Generic.LearnApp.kLAImport4
			kLAImport5: language.Generic.LearnApp.kLAImport5
			kLAImport6: language.Generic.LearnApp.kLAImport6
			kLAImportTool: language.Generic.LearnApp.kLAImportTool
			kLAImportToolManual: language.Generic.LearnApp.kLAImportToolManual
			kImportIntoLA: language.Generic.LearnApp.kImportIntoLA
			kSelectLA: language.Generic.LearnApp.kSelectLA
			productName: appContext.productName
			activities: []
		$scope.TTSUrl = ""

		$scope.products = []
		$scope.versions = []

		$scope.LAList = () ->
			ok 'MenuForm', '/asp/LearnApp/LAList.asp'
		$scope.laImport = () ->
			$.show.fileDialog
				title: language.Generic.LearnApp.kImportLearnCourses,
				fileExts: ['.mdb'],
				additionalContent: '<input id="grIDFile" type="hidden" name="GroupID" />',
				invalidFileExtMsg: language.Generic.LearnApp.kAlertInvalidExt,
				url: '/asp/LearnApp/LADoImport.asp',
				contentHtml: $('#laImportTempl').html().replace(/(?:\r\n|\r|\n)/g, ''),
				onShownDlg: () -> 
					if $('#grID').val() == null
						$('#grIDFile').val('-1')
					else
						$('#grIDFile').val($('#grID').val())
				customCheck: () ->
					LAN = _.filter($('select[name="LAN"]'), (elem) -> $(elem).parents(".modal-dialog").length > 0)[0]
					if(Number(LAN.value) == 0) 
						alert(language.Generic.LearnApp.kAlertEnterLAName);
						LAN.focus(); 
						return false;

					form = $('form[name="selectFile"]');
					form.append($('<input type="hidden" name="LAN" />').val(LAN.value.replace(/courses\|(.*)/g, '$1')));

					return $.show.confirmation(language.Generic.LearnApp.kConfirmMayTakeTime);
				maxFileSize: $scope.uploadLimit

		$scope.buttons = [
				{
					name: language.Generic.LearnApp.kBtnLAList
					style: "glyphicon-list"
					action: $scope.LAList
				}
				{
					name: language.Generic.LearnApp.kImportLearnCourses
					style: "glyphicon glyphicon-import"
					action: $scope.laImport
				}
			]
		
		$scope.action = (element) ->
			do element.action

		mapActivity = (activities) ->
			if(activities.length == 1 && activities[0].id == "courses")
				$scope.ciform.activities = _.chain $scope.products
											.map (o) -> _.defaults o, activities[0]
											.value()
				return $scope.ciform.activities

			else return _.map activities, (o) -> 
					if(o.publisher.code == "nd")
						o.img = "/static/dist/app/school/activities/img/thumb_" + o.id + ".jpg"
					return o
		getTTSUrlHandler = (response) -> $scope.TTSUrl = response.data
		getTTSUrlRequestStatus = $http.get "/webapi/activity/TTSUrl"
				.then getTTSUrlHandler, defaultErrorCatcher

		requests = 
			getAllActivity: () ->
				handler = (response) ->
					f = (a) -> a.groupName + '. ' + a.publisher.name
					$scope.groups = _.chain(response.data)
						.groupBy (a)-> a.groupId
						.map (a, key) -> 
							return {
								id: key
								name: f(a[0])
								class: null
								activities: mapActivity(a)
							}
						.value()
					$scope.group = $scope.groups[0]
					$scope.selectGroup($scope.groups[0])

				versionKey = "LACourse"
				$http.get(urlHelper.makeUrl("/webapi/grade/activities", {version: $scope.versions[versionKey]}))
				.then(handler, defaultErrorCatcher)
			getProducts: () -> 
				versionKey = "LACourse"
				requests.getVersion(versionKey).then () ->
					handler = (response) -> $scope.products = response.data
					$http.get(urlHelper.makeUrl("/webapi/grade/products", {version: $scope.versions[versionKey]}))
					.then handler, defaultErrorCatcher
			laPost: (url, data) -> 
				getValue = (name) -> $("input[name='"+name+"'][type='hidden']").val()
				_.extend data,
					AT: appContext.at
					LoginType: getValue('LoginType')
					Ver: getValue('ver')
					Back: window.location.pathname
				postTo url, data
			role: () ->
				handler = (resp) ->
					response = resp.data
					$scope.rights =
						add : _.contains(response, "add")
						read : _.contains(response, "read")
						journalAssign : _.contains(response, "journalAssign")
				$http.get "/webapi/activity/rights"
				.then handler, defaultErrorCatcher
			uploadLimits: () ->
				handler = (response) -> $scope.uploadLimits = response.data
				$http.get "/webapi/attachments/uploadLimits"
				.then handler, defaultErrorCatcher
			getVersion: (key) ->
				handler = (response) -> $scope.versions[key] = response.data
				$http.get(urlHelper.makeUrl("/webapi/version", {key: key}))
				.then handler, defaultErrorCatcher
			
		$scope.selectGroup = (group) ->
			$scope.ready = false
			$scope.group.class = null
			$scope.group = group
			$scope.group.class = 'active'
			$scope.ready = true

		defaultErrorCatcher = (response) ->
			if response?.data
				$.show.error response.data.message || response.data.details || response.data || language.Generic.Common.kErrorMsg
			else
				$.show.error language.Generic.Common.kErrorMsg

		defaultSilentErrorCatcher = (response) ->
			if appContext.environment == "dev"
				console.debug response.data.message || response.data.details || response.data || language.Generic.Common.kErrorMsg

		wndApp = null;
		$scope.laView = (activity) ->
			if (activity.IsDeleted == 1)
				alert(language.Generic.LearnApp.kMsgLAWasDeleted);
				return 
			url = urlHelper.makeUrl "/asp/RemoteHostProxy.asp",
				PROXYURL: activity.problemListUrl
				TTSURL: $scope.TTSUrl
				RO: 1
				LAID: activity.id
					
			winOptions = 
				url: url 
				name: '_blank',
				specs: 'status=yes,toolbar=no,menubar=no,location=no,scrollbars=yes,resizable=yes,directories=no,width=950,height=660'
				winChild: wndApp
						
			windowOpen(winOptions)
			wndApp = winOptions.winChild

		$scope.laAssign = (activity) ->
			requests.laPost '/asp/Grade/LAAssignments.asp', 
				LAID: getId(activity)
				LADELETED: laDeleted(activity.isDeleted)
				LANAME: activity.name
				LaURL: activity.problemListUrl

		$scope.laJournal = (activity) ->
			requests.laPost '/asp/Grade/Gradebook.asp', 
				LAID: getId(activity)

		getId = (activity) ->
			if(activity.groupId == 1)
				return 'courses|'+activity.id
			return activity.id

		laDeleted = (isDeleted) ->
			if(isDeleted)
				return 'Y'
			return 'N'

		$q.all([
			requests.getProducts()
				.then(requests.getAllActivity), 
			requests.role(), 
			requests.uploadLimits(),
			getTTSUrlRequestStatus
		]).then () -> 
			$appLoader.hide()

		$scope.yaClass = null
		yaHandler = (response) -> 
			$scope.yaClass = response.data
			console.log response
		$http.get "/webapi/yaClass/Get"
		.then yaHandler, defaultSilentErrorCatcher

		$scope.gotoYaClass = () ->
			winOptions = { url: $scope.yaClass.authUrl, name: "_blank", winChild: $scope.wnd };
			windowOpen(winOptions);
			$scope.wnd = winOptions.winChild;


)(window.angular)


