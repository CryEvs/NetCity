((angular) ->

	module = angular.module 'irtech.netcity.school.activities', ['ngRoute', 
		'ngSanitize', 'ngMessages', 'ui.select', 'uikit.alerts', 'uikit.dialogs', 'ui.bootstrap', 'ui.bootstrap.tooltip',
		"irtech.netcity.common", "irtech.netcity.ui-components"]

	require("./learningApplicationsController.coffee");

	module.config ($routeProvider, $locationProvider) ->
		$routeProvider
			.otherwise
				redirectTo: '/'
				templateUrl: '/static/dist/app/school/activities/template.html'
				controller: 'learningApplicationsController'
				resolve:
					style: ->
						angular.element('head').append('<link href="/static/dist/app/school/activities/style/activities.css" rel="stylesheet">');

		$locationProvider.hashPrefix('')
		$locationProvider.html5Mode
			enabled: true,
			requireBase: true

	.run ($rootScope, $http) ->

		# Проверка прав доступа
		rights = [35]
		
		if(_.intersection(context.rights, rights).length == 0)
			console.log("Access denied")
			postTo "/asp/errorAccess.asp"
	
	return
)(window.angular)


