angular.module('netcity.helpers', [])

.provider '$collectionHelper', ->
	@$get = () ->
		# Рекурсивное преобразование элементов дерева. 
		# items - объект или список объектов
		# transformFunc(item, parentItem, items) - функция трансформации элемента
		#	item - текущий, трансформируемый объект
		#	parentItem - родитель для текущего объекта
		# getChildList - функция получения дочерних объектов
		treeTransform: (items, transformFunc, getChildList) -> 
			transformItem = (item, parent) ->
				childs = getChildList(item)
				item = transformFunc(item, parent)
				recurs(childs, item)
				item
				
			transformCollection = (items, parent) ->
				for item, index in items
					items[index] = transformItem(item, parent)
				return

			recurs = (childs, parent) ->
				if !childs || !childs.length || childs.length < 1
					return
				transformCollection(childs, parent)
				return

			if !items
				return
			if _.isArray items
				transformCollection(items, null)
			else
				items = transformItem(items, null)
			return items
		# Рекурсивный обход дерева
		# items - объект или список объектов
		# getChildList - функция получения дочерних обЪектов
		# action - произвольное действие
		treeForEach: (items, getChildList, action) ->
			recurs = (item) ->
				childs = getChildList(item)
				if !childs || !childs.length || childs.length < 1
					return
				for child, index in childs
					action(child)
					recurs(child)
			if !items
				return
			if _.isArray items
				for item in items
					recurs(item)
			else
				action(items)
				recurs(items)
			return items

		treeToFlatArray: (items, getChildList) ->
			retArr = new Array()
			func = (items) ->
				_.each(items, (item) ->
					retArr.push(item)
					childs = getChildList(item)
					if angular.isArray(retArr)
						func(childs)
				)
			func(items)
			retArr

		treeSearch: (items, getChildList, searchCriteria) ->
		
			iterate = (items) ->
				for item in items
					result = recurs(item)
					if result
						return result
				return null
			
			recurs = (item) ->
				childs = getChildList(item)
				if !childs || !childs.length || childs.length < 1
					return
				searchResult = _.where(childs, searchCriteria)
				if searchResult.length > 0
					return searchResult[0]
				iterate(childs)

			iterate(items)
	return
	
# Маппинг js объектов. Аналогично AutoMapper c#
.provider "$autoMapper", ->
	@$get = () ->
		dictionary = {}
		#метод определение мапы
		createMap: (sourceKey, destinationKey) ->
			combinedKey = "#{sourceKey}_#{destinationKey}";
			dictionary[combinedKey] = {};
			functions = 
				forMember :  (key, e) ->
					dictionary[combinedKey][key] = e;
					functions
				forAllMembers: (func) ->
					dictionary[combinedKey].__forAllMembers = func;
					functions
		#выполнение маппинга
		map: (sourceKey, destinationKey, sourceValue, destinationValue, lazy) ->
			if !sourceValue && sourceValue != false
				return;

			getValue = (item) ->
				if typeof item == "function" && !lazy
					return item()
				return item;

			combinedKey = "#{sourceKey}_#{destinationKey}";
			mappings = dictionary[combinedKey];
			output = null
			key = null
			extensions =
				ignore : () ->
				mapFrom : (sourceMemberKey) ->
					if ! @__sourceValue.hasOwnProperty(sourceMemberKey)
						throw "#{sourceKey}.#{sourceMemberKey} не определено"

					value = getValue(@__sourceValue[sourceMemberKey])
					if mappings.__forAllMembers
						mappings.__forAllMembers(@__destinationValue, this.__key, value)
					else
						@__destinationValue[@__key] = value

			if !mappings
				throw "Не найден соответствующий маппинг из источника #{sourceKey} в получателя #{destinationKey}";

			mapItem = (destinationValue, sourceValue) ->
				for key of destinationValue
					if !destinationValue.hasOwnProperty(key) 
						continue;
					if mappings.hasOwnProperty(key) && mappings[key]
						if typeof mappings[key] == "function"
							extensions.__key = key;
							extensions.__sourceValue = sourceValue;
							extensions.__destinationValue = destinationValue;

							output = mappings[key].call(extensions);
						else 
							#forMember second parameter was not a function
							output = mappings[key];

						# object was returned from the 'forMember' call
						if output
							value = getValue(output);
							if mappings.__forAllMembers
								mappings.__forAllMembers(destinationValue, key, value);
							else
								destinationValue[key] = value;
					else if !sourceValue.hasOwnProperty(key)
						throw "#{sourceKey}.#{key} не определено";
					else
						value = getValue(sourceValue[key]);
						if mappings.__forAllMembers
							mappings.__forAllMembers(destinationValue, key, value);
						else
							destinationValue[key] = value;
				return

			#начало маппинга
			if sourceValue instanceof Array 
				if destinationValue instanceof Array
					for srcVal, i in sourceValue
						if !destinationValue[i]
							if typeof destinationKey != "function"
								throw "destinationKey of mapping must be a function in order to initialize the array";
							destinationValue[i] = destinationKey();
						mapItem destinationValue[i], srcVal
				else
					throw "Cannot map array to object";
			else if destinationValue instanceof Array
				throw "Cannot map object to array";
			else
				mapItem destinationValue, sourceValue
			return
	return



