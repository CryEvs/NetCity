'use strict'

angular.module('irtech.netcity.em.statreports.common', [])
	.factory('indicatorsRepository', ($http, $dialogs, $alerts, $showerModalDialog) ->
			notify = (action, message) ->
				action.then -> $alerts.success message
				action
			
			longWork = (work, message) ->
				$showerModalDialog.show()
				work.finally( -> $showerModalDialog.close())
				work

			calculators:
				get: (indicatorLevel, indicatorValueType) -> 
					longWork $http.get("/webapi/calculators/?indicatorLevel=#{indicatorLevel}&valueType=#{indicatorValueType}")
			indicators: 
				getPredefinedGroups: (indicatorLevel) ->
					longWork notify $http.get("/webapi/indicators/predefinedGroups/?indicatorLevel=#{indicatorLevel}"), language.Generic.StatReports.kIndicatorGroupsWasLoaded

			filters:
				getChildEMs: ->
					longWork $http.get("/webapi/em/childEMs")
				getFuncTypes: (emId)->
					longWork $http.get("/webapi/em/#{emId}/funcTypes")
			
			educInstitutions:
				#получение списка подчиненных ОО
				get: ()->
					longWork notify $http.get("/webapi/em/educInstitutions"), language.Generic.StatReports.kEducInstitutionsWasLoaded
					
			educManagements:
				#получение списка подчиненных ОО
				get: ()->
					longWork notify $http.get("/webapi/em/educManagements"), language.Generic.StatReports.kSubEmListWasLoaded

			educInstIndicators:
				get: (indicatorGroupId) ->
					longWork notify $http.get("/webapi/educInstitution/indicators/#{indicatorGroupId}"), language.Generic.StatReports.kIndicatorsWasLoaded
				getGroups: -> 
					longWork $http.get("/webapi/educInstitution/indicators/groups")
				getIndicatorValues: (indicatorGroupId) -> 
					longWork notify $http.get("/webapi/educInstitution/indicators/#{indicatorGroupId}/values"), language.Generic.StatReports.kIndicatorsDataWasLoaded
				saveIndicatorValues: (indicatorValues, groupIndicatorId) ->
					notify $http.post("/webapi/educInstitution/indicators/#{groupIndicatorId}/values", indicatorValues), language.Generic.StatReports.kChangesWasSaved
				approveIndicatorGroups: (indicatorGroupIds) ->
					notify $http.post("/webapi/educInstitution/indicators/values/approve", indicatorGroupIds), language.Generic.StatReports.kIndicatorGroupSuccessApproved
				approveIndicatorGroup: (indicatorGroupId, syId, accessType, text) ->
					notify $http.get("/webapi/em/indicators/subscribed/#{indicatorGroupId}/values/approve/?accessType=#{accessType}&syId=#{syId}"), text
				disapproveIndicatorsGroups: (indicatorGroupId, syId) ->
					notify $http.post("/webapi/educInstitution/indicators/values/approve", indicatorGroupIds), language.Generic.StatReports.kDataOpenedForEditing
				getCalculatedIndicatorValues: (indicatorGroupId) -> 
					longWork $http.get("/webapi/educInstitution/indicators/#{indicatorGroupId}/values/calculated"), language.Generic.StatReports.kCalcWasSuccess

			emIndicators:
				subscribed:
					get: (indicatorGroupId) -> 
						longWork (notify $http.get("/webapi/em/indicators/subscribed/#{indicatorGroupId}"), language.Generic.StatReports.kIndicatorsWasLoaded), language.Generic.StatReports.kIndicatorListLoading
					getGroups: -> 
						$http.get("/webapi/em/indicators/subscribed/groups")
					getIndicatorGroup: (indicatorGroupId, indicatorLevel) ->
						longWork $http.get("/webapi/em/indicators/subscribed/groups/#{indicatorGroupId}/?indicatorLevel=#{indicatorLevel}")
					saveIndicatorValues: (indicatorValues, groupIndicatorId) ->
						notify $http.post("/webapi/em/indicators/subscribed/#{groupIndicatorId}/values", indicatorValues), language.Generic.StatReports.kChangesWasSaved
					approveIndicatorGroups: (indicatorGroupIds) ->
						notify $http.post("/webapi/em/indicators/subscribed/values/approve", indicatorGroupIds), language.Generic.StatReports.kIndicatorGroupSuccessApproved
					approveIndicatorGroup: (indicatorGroupId, emId, accessType, text) ->
						notify $http.get("/webapi/em/#{emId}/indicators/subscribed/#{indicatorGroupId}/values/approve/?accessType=#{accessType}"), text
					getIndicatorValues: (indicatorGroupId) -> 
						longWork notify $http.get("/webapi/em/indicators/subscribed/#{indicatorGroupId}/values"), language.Generic.StatReports.kIndicatorsDataWasLoaded
					getCalculatedIndicatorValues: (indicatorGroupId) -> 
						longWork notify $http.get("/webapi/em/indicators/subscribed/#{indicatorGroupId}/values/calculated"), language.Generic.StatReports.kCalcWasSuccess

				published:
					get: (indicatorLevel, indicatorGroupId) ->
						longWork $http.get("/webapi/em/indicators/published/groups/#{if indicatorGroupId then indicatorGroupId + '/' else ''}?indicatorLevel=#{indicatorLevel}"), language.Generic.StatReports.kIndicatorListLoading
					getGroups: (indicatorLevel) ->
						longWork notify $http.get("/webapi/em/indicators/published/groups/?indicatorLevel=#{indicatorLevel}"), language.Generic.StatReports.kIndicatorsInfoWasLoaded
					getRootGroups: (indicatorLevel) ->
						longWork notify $http.get("/webapi/em/indicators/published/groups/roots/?indicatorLevel=#{indicatorLevel}"), language.Generic.StatReports.kIndicatorsInfoWasLoaded
					getRegionRootGroups: (indicatorLevel) ->
						longWork notify $http.get("/webapi/em/indicators/published/regionGroups/?indicatorLevel=#{indicatorLevel}"), language.Generic.StatReports.kIndicatorsInfoWasLoaded
					renumber: (numbers) ->
						$http.post("/webapi/em/indicators/published/renumber", numbers)
					regionPublish: (indicatorLevel) ->
						longWork $http.post("/webapi/em/indicators/published/regionpublish/?indicatorLevel=#{indicatorLevel}")
					getIndicatorValues: (indicatorGroupId, indicatorLevel) ->
						src = if indicatorLevel == 0 then "educInst" else "em"
						longWork notify $http.get("/webapi/em/indicators/published/groups/#{indicatorGroupId}/values/#{src}"), language.Generic.StatReports.kIndicatorsDataWasLoaded
					getEmAccessJournal: (indicatorGroupId, funcTypeId) ->
						longWork $http.get("/webapi/em/indicators/published/groups/#{indicatorGroupId}/emAccessJournal")
					getEducInstAccessJournal: (indicatorGroupId, funcTypeId, emId) ->
						longWork $http.get("/webapi/em/indicators/published/groups/#{indicatorGroupId}/educInstAccessJournal/?eoFuncType=#{funcTypeId}&emId=#{emId}")
					editExplanation: (indicatorGroupInfo) ->
						longWork $http.post("/webapi/em/indicators/published/edit/explanation", indicatorGroupInfo)
					#CRUD
					add: (indicator) ->
						longWork $http.put("/webapi/em/indicators/published", indicator)
					update: (indicator) ->
						longWork notify $http.post("/webapi/em/indicators/published", indicator), language.Generic.StatReports.kIndicatorWasSaved
					remove: (indicatorId) ->
						longWork $http.delete("/webapi/em/indicators/published/#{indicatorId}")
					#CRUD
	)


