angular.module('irtech.netcity.em.statreports.common')
.controller('FillIndicators.View.Common', 
		($scope, fillIndicatorsRepository, $alerts, $dialogs, $errorHandler, $collectionHelper) ->
			$scope.bDataWasChanged
			$scope.language = language

			### mappingAddValue - добавляет ко всем объектам indicator свойство Value ###
			mappingAddValue = (indicatorList) -> 
				$collectionHelper.treeForEach(
						indicatorList,
						(ind) -> ind.subIndicators,
						(ind) -> 
							indicatorValue = $scope.indicatorValuesIndexer[ind.id]
							if typeof indicatorValue isnt 'undefined'
								ind.value = indicatorValue.value
				)

			#построение списка пар идентификатор индикатора - значение
			mappingToIndicatorValue = (list) -> _.map(list, (indicator) -> indicatorId : indicator.id, value : indicator.value)

			$scope.existsIndicatorGroups = -> typeof $scope.indicatorGroupsList isnt 'undefined' and $scope.indicatorGroupsList.length > 0

			###Подгружается список индикаторов и их значений###
			initIndicators = ->
				$scope.bDataWasChanged = false
				if $scope.existsIndicatorGroups()
					fillIndicatorsRepository
						.getIndicatorValues($scope.indicatorGroup.id)
						.then((response) ->
							$scope.indicatorValuesIndexer = _.indexBy(response.data, "indicatorId")
							fillIndicatorsRepository
								.get($scope.indicatorGroup.id)
								.then(	
									(response) -> 
										$scope.indicatorList = mappingAddValue(response.data)
										$scope.indicator = $scope.indicatorList[0]
										$scope.isApprovedIndicatorGroup = $scope.indicator.isApproved
										
									(response) -> $errorHandler.responseHandler(response, language.Generic.StatReports.kErrIndicatorListLoading)
								)
							return)
				return

			#Метод наполнения таблицы(одной группы индикаторов, для которой выполняется авторасчет)
			#подсчитанными значениями
			fillCalculatedValues = (indicatorGroupId) ->
				_.each($scope.indicatorList, 
					(indicatorGroup, index) ->
						if indicatorGroup.id == indicatorGroupId
							$scope.indicatorList[index] = mappingAddValue([$scope.indicatorList[index]])[0]
							return
				)
				return

			###Загрузка списка групп индикаторов для селекта###
			initIndicatorGroups = ->
				fillIndicatorsRepository
					.getIndicatorGroups()
					.then((result) -> 
							$scope.indicatorGroupsList = result.data
							if typeof $scope.indicatorGroup is 'undefined' or $scope.indicatorGroup is null
								$scope.indicatorGroup = result.data[0]
							else
								$scope.indicatorGroup = _.findWhere($scope.indicatorGroupsList, {id: $scope.indicatorGroup.id})
							$scope.previousIndicator = $scope.indicatorGroup
								
							_.each($scope.indicatorGroupsList, 
								(indicatorGroup) ->
									if indicatorGroup.number is ''
										indicatorGroup.name = indicatorGroup.name
									else
										indicatorGroup.name = indicatorGroup.number + '. ' + indicatorGroup.name
									indicatorGroup
								)
												
							initIndicators()
							return)
				return

			$.extend $scope,						
				calculate: (indicatorGroupId) ->
					fillIndicatorsRepository.getCalculatedIndicatorValues(indicatorGroupId)
						.then(
							(response) -> 
								$scope.indicatorValuesIndexer = _.indexBy(response.data, "indicatorId")
								fillCalculatedValues(indicatorGroupId)
								$scope.bDataWasChanged = true
							(response) -> $errorHandler.responseHandler(response, language.Generic.StatReports.kAutomaticCalculationErr))

				inputChange: ->	$scope.bDataWasChanged = true

				indicatorGroupChange: ->
					if $scope.bDataWasChanged 
						$dialogs
							.confirm(language.Generic.StatReports.kDataWasChangedContinueWithoutChangingData)
							.then(	->
										initIndicatorGroups()
										return
									-> $scope.indicatorGroup = $scope.previousIndicator)
					else
						initIndicatorGroups()
					return

				prepareSaveData: ->
					#преобразование иерархического дерева в линейный массив индикаторов
					flatArray = $collectionHelper.treeToFlatArray(@indicatorList, (ind) -> ind.subIndicators)
					#преобразование в список пар Id - Value
					indValues = mappingToIndicatorValue(flatArray)
					#фильтрация пустых значений
					_.reject(indValues, (indValue) -> typeof indValue.value is 'undefined' or indValue.value == '' or indValue.value is null)
						
				approveIndicatorGroup: (groupId) -> 
					if $scope.fillIndicators.$invalid
						$alerts.error language.Generic.StatReports.kEnteredIncorrectData, language.Generic.StatReports.kEnterCorrectDataInRedFields
						return
						
					$dialogs
						.confirm(language.Generic.StatReports.kImpossibleMakeChangesAfterApproval)
						.then( -> 
								if $scope.bDataWasChanged
									saveData = $scope.prepareSaveData()
									fillIndicatorsRepository
										.save(saveData, $scope.indicatorGroup.id)
										.then(	(data) -> 
													$scope.bDataWasChanged = false
													$scope.approve(groupId)
													return
												(data) -> 
													$errorHandler.responseHandler(data, language.Generic.StatReports.kSavingError)
													initIndicators()
													return
											)
								else
									$scope.approve(groupId)
									return
							)
						
				approve: (groupId) ->
					fillIndicatorsRepository
						.approve([groupId])
						.then(
							() -> initIndicators(),
							(data) -> 
								$errorHandler.responseHandler(data, language.Generic.StatReports.kErrApproving)
								initIndicators()
						)
					return
						
				save: ->
					if $scope.fillIndicators.$invalid
						$alerts.error language.Generic.StatReports.kEnteredIncorrectData, language.Generic.StatReports.kEnterCorrectDataInRedFields
						return
					saveData = @prepareSaveData()
					fillIndicatorsRepository
						.save(saveData, $scope.indicatorGroup.id)
						.then(	(data) -> 
									$scope.bDataWasChanged = false
								(data) -> 
									$errorHandler.responseHandler(data, language.Generic.StatReports.kSavingError)
									initIndicators()
									return
							)
					return
			
			initIndicatorGroups()
			return
)


