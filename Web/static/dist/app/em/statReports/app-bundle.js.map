angular.module('irtech.netcity.em.statreports')
.controller('EmStatReports.View',
	($scope, $alerts, $dialogs, $collectionHelper, indicatorsRepository, $errorHandler) ->
		$scope.language = language
		$('body').addClass("claro");
		$scope.$parent.page =
			parent:
				title: language.Generic.StatReports.kStatReports
				href: "/angular/em/statreports/"
			back:
				history: true
			title: language.Generic.StatReports.kViewStatIndicatorData

		#класс описывающий индикатор. со ссылкой на родительский индикатор
		class IndicatorInfo
			constructor: (dto, parent) ->
				@getParent = ()-> parent
				angular.extend this, dto

			getFullNumber: () ->
					parent = @getParent()
					if parent
						parent.getFullNumber() + '.' + @number
					else
						@number

		levels = []
		recurs = (indicatorInfo, levels) ->
			parent = indicatorInfo.getParent()
			if parent
				recurs(parent, levels)
			levels.push indicatorInfo.name

		getIndicatorLevelName = (depth) ->
			if depth > 0
				language.Generic.StatReports.kStatReportIndicatorGroupLevel + ' ' + depth
			else
				language.Generic.StatReports.kStatReportIndicatorGroupTitle

		$scope.dataLoaded = false

		#класс описывающий линейное представление OLAP факта.
		class FlatData
			constructor: (dto) ->
				indicator = $scope.$indicatorsIndex[dto.indicatorId]

				if dto.educInstId
					educInstInfo = $scope.educInstitutions[dto.educInstId]
					if educInstInfo
						@["Регион"] = educInstInfo.stateName
						@["Город"] = educInstInfo.cityName
						@["УО"] = educInstInfo.emName
						@["Функциональность ОО"] = educInstInfo.functionalityName
						@["Тип ОО"] = educInstInfo.typeName
						@["ОО"] = educInstInfo.educInstName
				else if dto.emId
					emInfo = $scope.educManagements[dto.emId]
					@["Регион"] = emInfo.stateName
					@["УО"] = emInfo.emName

				@["Значение"] = dto.value

				#установка для всех индикаторов пустых значений для всех уровней подиндикаторов
				for levelName in $scope.levels
					@[levelName] = ""

				levels = []
				recurs(indicator, levels )

				#инициализация уровней индикатора соответствующим значениям согласно индикатору
				for levelName, index in levels
					@[getIndicatorLevelName(index)] = levelName

		$scope.indicatorLevels = [
			{ name: language.Generic.StatReports.kEducInst, value: 0 }
			{ name: language.Generic.StatReports.kEducManagements, value: 1 }
		]

		$scope.reportGroups = [
			{name: language.Generic.StatReports.kMunicipalReports, value: 0}
			{name: language.Generic.StatReports.kRegionReports, value: 1}
		]

		#словарь идентификатор ОО - информация об ОО
		$scope.educInstitutions = {}
		#словарь идентификатор ОО - информация об ОО
		$scope.educManagements = {}
		#словарь идентификатор индикатора - информация об индикаторе
		$scope.$indicatorsIndex = {}

		#загрузка групп индикаторов и информации об индикаторах
		loadGroups = () ->
			if $scope.reportGroup.value is 1
				getGroups = indicatorsRepository.emIndicators.published.getRegionRootGroups
			else
				getGroups = indicatorsRepository.emIndicators.published.getRootGroups

			getGroups($scope.indicatorLevel.value)
				.then (response)->
					$scope.rootGroups = response.data
				.catch (response) -> $errorHandler.responseHandler response

		$scope.reportGroup = $scope.reportGroups[0]
		$scope.indicatorLevel = $scope.indicatorLevels[0]

		$scope.$watch('indicatorLevel', loadGroups)
		#$scope.$watch('reportGroup', loadGroups)


		#загрузка списка ОО
		indicatorsRepository.educInstitutions.get()
			.then (response) -> $scope.educInstitutions = _.indexBy(response.data, "educInstId")
			.catch (response) -> $errorHandler.responseHandler response

		#загрузка списка УО
		indicatorsRepository.educManagements.get()
			.then (response) -> $scope.educManagements = _.indexBy(response.data, "emId")
			.catch (response) -> $errorHandler.responseHandler response

		#инициализация OLAP браузера
		#window.require ["wpt/WebPivotTable", "dojo/domReady!"], (wpt) -> window.wpt = wpt


		options =
			customOptions:
				locale: 'ru'
				uiFlags:
					menuBtn: 0
					dataSourceBtn: 0
					languageSwitchBtn: 0
					helpBtn: 0
					aboutBtn: 0

					openWptMenu: 0
					saveWptMenu: 0
					sourceDataMenu: 0

					settingMenu: 0

					nonEmptyBtn: 0
					mdxBtn: 0

					pivotFieldsPaneBtn: 1,
					positionPivotContentBtn: 1

					gridOptionBtn: 1
					gridStyleBtn: 1
					gridZoomBtn: 1
					gridFullScreenBtn: 1
					gridExportExcelBtn: 1

					chartOptionBtn: 1
					chartZoomBtn: 1
					chartFullScreenBtn: 1

					csvGridSizeBtn: 1
					csvGridZoomBtn: 1
					csvGridExportExcelBtn: 1
				expandRows: 1
				expandCols: 1

				pivotLayout: 2

				grid:
					showColSubtotals: 0
					showColTotals: 0
					compactForm: 0


		#)
		$scope.wpt = $scope.$parent.wpt or new window.wpt(options, "wpt-container")
		$scope.$parent.wpt = $scope.wpt
		$scope.dataLoaded = false

		$.extend $scope,
			export: () ->
				if !$scope.indicatorGroup
					$dialogs.notify language.Generic.StatReports.kAttention, language.Generic.StatReports.kMustSelectIndicatorGroup
					return
				postTo
					path: "/webapi/em/indicators/published/groups/#{$scope.indicatorGroup.id}/report"
					method: "GET"
					formParams:
						download: true
			# выгрузка всех групп отчетов
			exportAll: () ->
				if $scope.rootGroups?.length == 0
					$dialogs.notify language.Generic.StatReports.kAttention, language.Generic.StatReports.kIndicatorGroupListIsEmpty
					return
				postTo
					path: "/webapi/em/indicators/published/groups/report/#{$scope.indicatorLevel.value}"
					method: "GET"
					formParams:
						download: true
			show: ()->
				if !$scope.indicatorGroup
					$dialogs.notify language.Generic.StatReports.kAttention, language.Generic.StatReports.kMustSelectIndicatorGroup
					return

				indicatorInfoLoad = indicatorsRepository.emIndicators.published.get($scope.indicatorLevel.value, $scope.indicatorGroup.id)
					.then (response) ->
						#построение словаря для быстрого поиска
						$scope.$indicatorsIndex = {}
						$collectionHelper.treeTransform(
							response.data
							(dto, parentDto) ->
								indInfo = new IndicatorInfo(dto, parentDto)
								$scope.$indicatorsIndex[indInfo.id] = indInfo
								indInfo
							(item) -> item.subIndicators)

				#загрузка значений индикаторов
				indicatorsRepository.emIndicators.published.getIndicatorValues($scope.indicatorGroup.id, $scope.indicatorLevel.value)
					.then (response)->
						$scope.indicatorsValues = response.data

						#ждем загрузки инфы об индикаторе
						indicatorInfoLoad.then () ->
							$scope.dataLoaded = true

							indicatorInfo = $scope.$indicatorsIndex[$scope.indicatorGroup.id]

							$scope.indicatorGroupDepth = 0
							$collectionHelper.treeForEach(
								indicatorInfo,
								(ind) -> ind.subIndicators,
								(ind) ->
									parent = ind.getParent()
									if parent?.depth
										ind.depth = parent.depth + 1
									else
										ind.depth = 1

									if ind.depth > $scope.indicatorGroupDepth
										$scope.indicatorGroupDepth = ind.depth
							  )

							$scope.levels = []
							for depthLevel in [0..$scope.indicatorGroupDepth-1]
								levelName = getIndicatorLevelName(depthLevel)
								$scope.levels.push levelName

							#построение списка линейных объектов описывающих каждое выставленное значение по индикатору
							$scope.flatData = _.chain($scope.indicatorsValues)
								.map((dto) -> new FlatData(dto))
								.filter((flat) -> flat["Регион"]) #отсекаем лишние значения индикаторов. для которых не заполнена информация
								.value();
							dataFields = _.keys(_.first($scope.flatData))

							$scope.CsvFields = _.union(dataFields, $scope.levels)

							$scope.CsvData = _.map($scope.flatData, (flat) ->
								_.toArray(flat)
							);

							cols = []
							for level, ind in $scope.levels
								cols.unshift dataFields.length - ind - 1

							if $scope.indicatorLevel.value == 0
								#УО и ОО
								rows = [2, 5]
							else
								rows = [0, 1]

							wptData =
								format: "WPT"
								version: "1.0"
								mode: "CSV"
								data: $scope.CsvData
								fields: $scope.CsvFields
								rows: rows
								cols: cols
								values: [
									id:1
									label: "Значение показателей"
									fieldIndex: dataFields.length - $scope.levels.length - 1
									stats: "Sum"
									showValueAs: 0
									format:
										  category: "GENERAL"
										  decimal: 2
										  separatorFlag: true
										  symbol: "$"
										  symbolSuffix: 0
										  negative: 0
									]

							$("#wpt-container").show();
							$scope.wpt.setCsvData($scope.CsvFields, $scope.CsvData, wptData);

							return
					.catch (response) -> $errorHandler.responseHandler response
				return
		return
)


