angular.module('irtech.netcity.em.statreports')
.factory('relevanceDataRepository', 
	(indicatorsRepository) ->
		baseRep = indicatorsRepository.emIndicators.subscribed
		get: (indicatorGroupId) -> baseRep.get indicatorGroupId
		save: (indicatorValues, groupIndicatorId) -> baseRep.saveIndicatorValues indicatorValues, groupIndicatorId
		approve: (arrIndicatorGroups) -> baseRep.approveIndicatorGroups arrIndicatorGroups
		getIndicatorGroups: -> baseRep.getGroups()
		getIndicatorValues: (indicatorGroupId) -> baseRep.getIndicatorValues indicatorGroupId
		getCalculatedIndicatorValues: (indicatorGroupId) -> baseRep.getCalculatedIndicatorValues indicatorGroupId
)
.controller('RelevanceData.View', 
		($scope, indicatorsRepository, $alerts, $dialogs, $errorHandler, $collectionHelper) ->
			$scope.language = language

			$scope.$parent.page = 
				parent: 
					title: language.Generic.StatReports.kStatReports
					href: "/angular/em/statreports/"
				back: 
					history: true
				title: language.Generic.StatReports.kRelevanceData

			$scope.cnstApprovedValues = 1
			$scope.cnstDisapprovedValues = 2
			$scope.indicatorLevels = [
				{ name: language.Generic.StatReports.kEducInst, value: 0 }
				{ name: language.Generic.StatReports.kEducManagements, value: 1 }
			]
			
			$scope.reportGroups = [
				{name: language.Generic.StatReports.kMunicipalReports, value: 0}
				{name: language.Generic.StatReports.kRegionReports, value: 1}
			]
															
			$scope.indicatorLevel = $scope.indicatorLevels[1]
			$scope.reportGroup = $scope.reportGroups[0]
			$scope.indicatorAccessJournals = []
			
			#обработчик кнопки Применить
			$scope.show = () ->
				if typeof $scope.indicatorGroup is 'undefined' or $scope.indicatorGroup is null
					$alerts.info(language.Generic.StatReports.kNotSelectedIndicatorGroups)
					return
				
				if $scope.indicatorLevel.value == 0 #если уровень ОО
					indicatorsRepository.emIndicators.published.getEducInstAccessJournal($scope.indicatorGroup.id, $scope.funcType.id, $scope.em.id)
						.then((response)->
								$scope.indicatorAccessJournals = response.data
								return
						)
				else #если уровень УО
					indicatorsRepository.emIndicators.published.getEmAccessJournal($scope.indicatorGroup.id)
						.then((response)->
								$scope.indicatorAccessJournals = response.data
								return
						)
				return

			#функция для конкатенации информации о дате и авторе последнего редактирования или утверждения
			$scope.showAuthorAndDate =  (author, date) ->
				result = ''
					
				if date isnt null
					result = date
				if author isnt null
					result += ' ' + author
				
				return result

			$scope.approveEm = (emId, accessType) ->
				text = if accessType is $scope.cnstApprovedValues then language.Generic.StatReports.kIndicatorGroupSuccessApproved else language.Generic.StatReports.kDataOpenedForEditing
				
				indicatorsRepository.emIndicators.subscribed.approveIndicatorGroup($scope.indicatorGroup.id, emId, accessType, text)
					.then(
						(response)->
							$scope.show()
						(response) -> 
							$errorHandler.responseHandler response, language.Generic.StatReports.kErrApproving
							$scope.show()
					)
					
			$scope.approveEducInst = (syId, accessType) ->
				text = if accessType is $scope.cnstApprovedValues then language.Generic.StatReports.kIndicatorGroupSuccessApproved else language.Generic.StatReports.kDataOpenedForEditing
				
				indicatorsRepository.educInstIndicators.approveIndicatorGroup($scope.indicatorGroup.id, syId, accessType, text)
					.then(
						(response)->
							$scope.show()
						(response) -> 
							$errorHandler.responseHandler response, language.Generic.StatReports.kErrApproving
							$scope.show()
					)

			#загрузка групп индикаторов и информации об индикаторах
			loadGroups = ->
				if $scope.reportGroup.value is 1
					getGroups = indicatorsRepository.emIndicators.published.getRegionRootGroups
				else
					getGroups = indicatorsRepository.emIndicators.published.getRootGroups
					
				getGroups($scope.indicatorLevel.value)
					.then(
						(response)-> $scope.rootGroups = response.data
						(response) -> $errorHandler.responseHandler response
					)

			loadEMs = ->
				if $scope.indicatorLevel.value isnt $scope.indicatorLevels[0].value then return
				
				indicatorsRepository.filters.getChildEMs()
					.then(
						(response)->
							$scope.ems = [{id: -1, name: language.Generic.Common.kAll}]
							$scope.ems = _.union($scope.ems, response.data)
							$scope.em = $scope.ems[0]
						(response) -> $errorHandler.responseHandler response
					)

			loadFuncTypes = ->
				if $scope.indicatorLevel.value isnt $scope.indicatorLevels[0].value then return
				
				currEmId = if typeof $scope.em is 'undefined'then -1 else $scope.em.id
								
				indicatorsRepository.filters.getFuncTypes(currEmId)
					.then(
						(response)->
							$scope.funcTypes = [{id: -1, name: language.Generic.Common.kAll}]
							$scope.funcTypes = _.union($scope.funcTypes, response.data)
							$scope.funcType = $scope.funcTypes[0]
						(response) -> $errorHandler.responseHandler response
					)
			
			refreshFilters = ->
				$scope.indicatorGroup = null
				$scope.indicatorAccessJournals = []
				loadGroups()
				loadEMs()
				
			$scope.$watch('indicatorLevel', -> refreshFilters())
			$scope.$watch('reportGroup', -> refreshFilters())
			
			$scope.$watch('em', -> loadFuncTypes())
)


