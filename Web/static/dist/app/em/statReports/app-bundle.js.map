angular.module('netcity.validation', [])

.provider('$errorHandler', ->
	@$get = ($alerts) ->
		responseHandler: (response, errMessage) ->
			@.errorList = []
			if(response.status == 401)
				$alerts.error 'Ошибка! Ваш сеанс работы был завершен'
				return
			else
				if response.headers('server-validation-exception') == 'true' #|| response.headers('business-logic-exception') == 'true'
					@.errorList = Array(response.data.message)
					return
				else
					errMessage = response.data.message || errMessage || 'Неожиданная ошибка'
					$alerts.error errMessage, response.data.details
					return
		errorList: []
	return
)


