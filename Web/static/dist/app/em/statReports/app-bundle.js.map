#Controllers
angular.module('uikit.controls.controllers', ['ui.bootstrap'])
	.controller('treeSelectCtrl', ($scope, $dialogs, $uibModal, $uibModalInstance, tree, header, treeCfg) ->
	
		treeSearch = (items, getChildList, searchCriteria) ->
			console.log "1,5"
			iterate = (items) ->
				for item in items
					result = recurs(item)
					if result
						return result
				return null
			
			recurs = (item) ->
				childs = getChildList(item)
				if !childs || !childs.length || childs.length < 1
					return
				searchResult = _.where(childs, searchCriteria)
				if searchResult.length > 0
					return searchResult[0]
				iterate(childs)

			iterate(items)
			
		showNode = (node) ->
			node.collapsed = false
			parent = node.getParent()
			if parent
				showNode(parent)
		
		mapParams = () -> 
			_.each(selectedNode.parameters, (param) -> 
				temp = _.findWhere(treeCfg.parameters, {argId: param.id})
				param.value = if typeof temp is 'undefined' then null else temp.value
			)
			return
			
	
		#TODO. search selected node and expand all parents
		if treeCfg.Current
			selectedNode = treeSearch(tree
				, (item) -> 
					item[treeCfg.childrens]
				, {Id: treeCfg.current })
			if selectedNode
				tree.currentNode = selectedNode
				selectedNode.selected = "selected"
				showNode(selectedNode)
		
		$.extend $scope,
			tree: tree
			header: header
			language: language
			treeCfg: treeCfg
			ok: (form) ->
				selectedNode = this.tree.currentNode
				if !selectedNode
					$dialogs.notify("Внимание", "Выберите элемент из списка.")
					return
				if typeof selectedNode.parameters isnt 'undefined' && selectedNode.parameters.length > 0
					if selectedNode.id is treeCfg.current and typeof treeCfg.parameters isnt 'undefined'
						mapParams()
						
					modalInstance = $uibModal.open
						templateUrl: '/static/dist/app/em/indicators/templates/enterParamValue.html'
						controller: 'Em.Indicators.EditIndicator.EnterParamValues'
						resolve:
							calculator: () -> selectedNode

					modalInstance.result.then((response) ->
						selectedNode.parameters = response
						$uibModalInstance.close(selectedNode)
					)
					return
				$uibModalInstance.close(selectedNode)
			cancel: ->
				$uibModalInstance.dismiss('cancel');
		return
	)
#Services	
angular.module('uikit.controls.services',['ui.bootstrap.modal','uikit.controls.controllers'])	
	.factory('$uiControls', ($uibModal) ->
	
		treeSelect: (header, tree, treeCfg) ->
			defaultCfg =
				id: "id"
				label: "name"
				childrens: "childrens"
				noText: "Нет данных"

			cfg = $.extend({}, defaultCfg, treeCfg)

			modalInstance = $uibModal.open
				templateUrl: '/static/dist/app/global/templates/treeSelect.html'
				controller: 'treeSelectCtrl'
				resolve:
					tree: () -> tree
					header: () -> angular.copy(header)
					treeCfg: () -> cfg

			modalInstance.result
);

angular.module('uikit.controls',['uikit.controls.services'])


