class TreeItem
	constructor: (id, name, parent, childs, parameters) ->
		@getParent = ()-> parent
		@id = id
		@name = name
		@childs = childs
		@parameters = parameters

class Indicator extends TreeItem
	constructor: (dto, parent) ->
		angular.extend this, dto 
		super(dto.id, dto.name, parent, dto.subIndicators)
	getFullNumber: () -> 
		parent = @getParent()
		if parent
			parent.getFullNumber() + '.' + @number
		else
			@number

angular.module('irtech.netcity.em.statreports')
.controller('Em.Indicators.View', 
		($scope, indicatorsRepository, $uibModal, $alerts, $collectionHelper, $dialogs, $errorHandler, $routeParams, $appLoader, $http) ->
		
			$errorHandler.errorList = []
			$indicatorLevel = $routeParams.it or 0
			window.$indicatorLevel = $indicatorLevel
			$scope.$parent.page = 
				parent: 
					title: language.Generic.StatReports.kStatReports
					href: "/angular/em/statreports/"
				back: 
					history: true
				title: if $indicatorLevel is 0 then language.Generic.StatReports.kSchoolIndicators else language.Generic.StatReports.kEmIndicators

			transformDto = (dtos) ->
				$collectionHelper.treeTransform dtos,
					(dto, parentDto)-> new Indicator(dto, parentDto),
					(dto) -> dto.subIndicators
				dtos
				
			$scope.indicatorGroup = null
			$scope.indicatorsLoaded = false
			$scope.regionShowGroup = false

			$http.get("/webapi/settings", {params: {id: 410}})
				.then (response) -> $scope.regionShowGroup = (response.data == "1")


			$scope.indicatorListEmpty = -> $scope.rootGroups?.length == 0
			$scope.indicatorSelected = -> $scope.indicatorGroup != null

			$.extend $scope,
				language: language
				predefinedGroups: []
				sortableOptions:
					accept: (sourceNodeScope, destNodesScope, destIndex) ->
						destNodesScope.isParent(sourceNodeScope)
					dropped: (event) ->
						if event.source.index ==  event.dest.index && event.dest.nodesScope == event.source.nodeScope.$parentNodesScope
							return
						_.each(event.dest.nodesScope.$nodes, (node) -> 
							node.$modelValue.number = node.index() + 1
						)
						$scope.renumber(event.dest.nodesScope.$nodes)
						return true
					dragStart: (event) ->
						return true
					dragMove: (event) ->
						return true
					dragStop: (event) ->
						return true
				load: ()->
					if !$scope.indicatorGroup
						return

					$scope.indicatorList = []
					$scope.indicatorList.push $scope.indicatorGroup

					$scope.indicatorsLoaded = true
					$appLoader.hide()

				renumber: (nodes) ->
					numbers = _.map(nodes, (node) ->
						indicatorId: node.$modelValue.id
						number: node.$modelValue.number
					)
					indicatorsRepository.emIndicators.published.renumber(numbers)
						.then -> $alerts.success language.Generic.StatReports.kIndicatorsWasSaved
						.catch (response) -> $errorHandler.responseHandler response
				
				#Региональная публикация
				publish: () ->
					indicatorsRepository.emIndicators.published.regionPublish($indicatorLevel)
						.then (response) -> $alerts.success language.Generic.StatReports.kIndicatorsPublishedSuccessfully
						.catch (response) -> $errorHandler.responseHandler response
				#Удалить
				del: (nodeScope) ->
					indicator = if nodeScope instanceof Indicator then nodeScope else nodeScope.$modelValue
					cfrm = if indicator.groupId is null then language.Generic.StatReports.kCfmRemoveReport else language.Generic.StatReports.kCfmRemoveIndicator

					$dialogs.confirm(cfrm)
						.then (btn) ->
							indicatorsRepository.emIndicators.published.remove(indicator.id)
								.then (response) ->
									if nodeScope not instanceof Indicator
										parentNodesScope = nodeScope.$parentNodesScope
										nodeScope.remove()

									parent = indicator.getParent()
									delRootNode = !parent
								
									container = if delRootNode then $scope.rootGroups else parent.subIndicators
									container = _.without container, indicator
								
									#renumber on client
									_.each(container, (neighborInd) -> 
										if neighborInd.number > indicator.number
											neighborInd.number--
									)

									if delRootNode
										$scope.rootGroups = container
										$scope.indicatorGroup = null
									else
										neighborNodes = _.without parentNodesScope.$nodes, nodeScope
										$scope.renumber(neighborNodes)

									$alerts.success language.Generic.StatReports.kIndicatorRemoved
								.catch (response) -> 
									$errorHandler.responseHandler response
				#Добавить группу
				addGroup: (node) ->
					addRootNode = !node
					container = if addRootNode then $scope.rootGroups else node.subIndicators

					newGroup = new Indicator(
						subIndicators: []
						groupId: node?.id
						level: $indicatorLevel
						isGroup: true
						number: container.length + 1
					, node)
					
					modalInstance = $uibModal.open
						templateUrl: '/static/dist/app/em/statreports/common/templates/editIndicatorGroup.html'
						controller: 'EmIndicators.EditGroup'
						resolve:
							group: -> newGroup
							
					modalInstance.result
					.then (createdGroup) ->
						createdGroup = transformDto createdGroup
						container.push createdGroup
						if addRootNode
							$scope.indicatorGroup = createdGroup 
							$scope.load()
					return

				#Добавить индикатор
				add: (node) ->
					container = node.subIndicators

					newIndicator = new Indicator(
						groupId: node.id
						isGroup: false
						level: $indicatorLevel
						valueType: 0
						number: container.length + 1
					, node)

					modalInstance = $uibModal.open
						templateUrl: '/static/dist/app/em/statReports/common/templates/editIndicator.html'
						controller: 'EmIndicators.Edit'
						resolve:
							indicator: -> newIndicator
							mode: -> "add"
					
					modalInstance.result
					.then (createdIndicator) ->
						newIndicator = _.extend newIndicator, createdIndicator
						container.push newIndicator
					return

				#Редактировать
				edit: (indicator) ->
					modalInstance = $uibModal.open
						templateUrl: '/static/dist/app/em/statReports/common/templates/editIndicator.html'
						controller: 'EmIndicators.Edit'
						resolve:
							indicator: -> indicator
							mode: -> "edit"

					modalInstance.result
					.then (modifiedIndicator) -> indicator = _.extend indicator, modifiedIndicator
					return
					
				editExplanation: () ->
					indicatorsRepository.emIndicators.subscribed
						.getIndicatorGroup($scope.indicatorGroup.id, $indicatorLevel)
							.then( 
								(response) -> 
									$scope.indicatorGroupInfo = response.data
								
									modalInstance = $uibModal.open
										templateUrl: '/static/dist/app/em/statreports/common/templates/editExplanation.html'
										controller: 'Em.Indicators.EditIndicator.EditExplanation'
										resolve:
											indicatorExplanation: -> $scope.indicatorGroupInfo.explanation
							
									modalInstance.result
										.then( (modifiedIndicatorExplanation) ->
											$scope.indicatorGroupInfo.explanation = modifiedIndicatorExplanation
											
											indicatorsRepository.emIndicators.published.
												editExplanation($scope.indicatorGroupInfo)
													.then(
														(response) -> 
															$alerts.success language.Generic.StatReports.kExplanationWasAddedSuccess,
														(response) ->
															$alerts.error response.data.message
													)
										)
								(response) -> 
									$alerts.error response.data.message || language.Generic.StatReports.kErrEditExplanation
							)
					return
					
				$errorHandler: $errorHandler

			indicatorsRepository.emIndicators.published.getGroups($indicatorLevel)
				.then (response) ->
					$alerts.success language.Generic.StatReports.kIndicatorGroupListWasLoaded
					#todo. long work
					$scope.rootGroups = transformDto response.data
					$scope.indicatorGroup = $scope.rootGroups[0]
					$scope.load()
					return
				.catch (response) -> $errorHandler.responseHandler response
			return
)
.controller('EmIndicators.Edit', 
	($scope, $alerts,  $uibModalInstance, $collectionHelper, indicator, mode, indicatorsRepository, $uiControls, $errorHandler, $dialogs, $q) ->
		$errorHandler.errorList = []
		
		$.extend $scope,
			header: if mode == "add" then language.Generic.StatReports.kCreatingIndicator else language.Generic.StatReports.kEditingIndicator
			editIndicator: _.clone indicator
			language: language
			indicatorValTypes: [
				{id: 0, name: language.Generic.StatReports.kNumber, key: "Numeric"}
				{id: 2, name: language.Generic.StatReports.kLogical, key: "Bool"}
			]
			
			#построение выражения
			buildCalcExp: ->
				indicatorsRepository.calculators
				.get($indicatorLevel, $scope.editIndicator.valueType)
				.then( (result) ->
						$alerts.success language.Generic.StatReports.kCalculatorListWasLoaded
					
						transformDto = (dtos) ->
							$collectionHelper.treeTransform dtos,
								(dto, parentDto)-> new TreeItem(dto.id, dto.name, parentDto, dto.calculators, dto.arguments),
								(dto) -> dto.calculators
							dtos
						
						tree = transformDto(result.data)
	
						if $scope.editIndicator.calcExpression
							currentCalculatorId = $scope.editIndicator.calcExpression.calculatorId
							if $scope.editIndicator.calcExpression.params
								currentParams = $scope.editIndicator.calcExpression.params
								
						$uiControls.treeSelect(language.Generic.StatReports.kSelectCalculator, tree, 
							{ childrens: "childs", current: currentCalculatorId, noText: language.Generic.StatReports.kCalculatorsNotFounded, parameters: currentParams })
						
					, (response) -> $errorHandler.responseHandler response )
				.then (calcExp) -> 
					#$alerts.success language.Generic.StatReports.kPredefinedIndicatorSelected
					#todo. выбирать не только калькулятор
					#$scope.currentParams = calcExp.Parameters
					result = _.map(calcExp.parameters, (parameter) ->
															arg = 
																argId: parameter.id
																value: parameter.value) 
					$scope.editIndicator.calcExpression = 
						calculatorId: calcExp.id
						valueType: $scope.editIndicator.valueType
						params: result
					return

			#удаление выражения
			removeCalcExp: ->
				$scope.editIndicator.calcExpression = null
				return

			#сохранение/создание
			ok: (form) ->
				if !$scope.editIndicator.name
					$dialogs.notify language.Generic.StatReports.kAttention, language.Generic.Common.kEnterTheName
					return
				if mode == "add"
					indicatorsRepository.emIndicators.published
						.add($scope.editIndicator)
						.then (response) -> 
							$alerts.success language.Generic.StatReports.kIndicatorAdded
							$scope.editIndicator = _.extend $scope.editIndicator, response.data
							$uibModalInstance.close($scope.editIndicator)
						.catch (response) -> $errorHandler.responseHandler response

				else if mode == "edit"
					save = ->
						indicatorsRepository.emIndicators.published
							.update($scope.editIndicator)
							.then (response) -> 
								$scope.editIndicator = _.extend $scope.editIndicator, _.omit(response.data, "subIndicators")
								$uibModalInstance.close($scope.editIndicator)
							.catch (response) -> 
								$errorHandler.responseHandler response
						
					if $scope.editIndicator.valueType == indicator.valueType
						save()
						return
					$dialogs.confirm(language.Generic.StatReports.kCfrmChangeIndicatorValueType + '\r\n' + language.Generic.Common.kCfrmContinue)
						.then -> 
							if !$scope.editIndicator.calcExpression || $scope.editIndicator.calcExpression.valueType == $scope.editIndicator.valueType
								save()
								return

							$dialogs.confirm(language.Generic.StatReports.kCfrmIndicatorCalcExpRemove + '\r\n' + language.Generic.Common.kCfrmContinue)
								.then -> 
									$scope.removeCalcExp()	
									save()

			cancel: ->
				$uibModalInstance.dismiss('cancel');
			$errorHandler: $errorHandler
		return
)
.controller('EmIndicators.EditGroup', 
	($scope, $uibModalInstance, $uibModal, $dialogs, $alerts, $collectionHelper, group, indicatorsRepository, $uiControls, $errorHandler) ->
		$errorHandler.errorList = []
		$.extend $scope,
			predefined: null
			editGroup: _.clone group
			language: language
			cancelPredefined: ->
				$scope.predefined = false
				$scope.editGroup.subIndicators = null
			#выбор предустановленного индикатора
			selectPredefined: ->

				indicatorsRepository.indicators
				.getPredefinedGroups($indicatorLevel)
				.then( 
					(response) -> 
						modalInstance = $uibModal.open
							templateUrl: '/static/dist/app/em/statReports/common/templates/selectPredefined.html'
							controller: 'EmIndicators.EditGroup.SelectPredefined'
							resolve:
								selected: -> $scope.predefined
								predefinedIndicators: -> response.data

						modalInstance.result
				, (response) -> $errorHandler.responseHandler response )
				.then (predefinedIndicator) -> 
					$alerts.success language.Generic.StatReports.kPredefinedIndicatorSelected
					$scope.predefined = predefinedIndicator
					
					indicatorCopy = _.extend {}, predefinedIndicator
					
					
					$collectionHelper.treeForEach(
						indicatorCopy
						(indicator) -> indicator.subIndicators
						(indicator) -> indicator.id = 0; indicator.isPredefined = false; indicator.groupId = 0; return)

					#замена номера
					indicatorCopy.number = $scope.editGroup.number
					indicatorCopy.groupId = $scope.editGroup.groupId
						
					$scope.editGroup = _.extend $scope.editGroup, indicatorCopy
					return

			ok: (form) ->
				if !$scope.editGroup.name
					$dialogs.notify language.Generic.StatReports.kAttention, language.Generic.Common.kEnterTheName
					return
				indicatorsRepository.emIndicators.published.add($scope.editGroup)
				.then (response) -> 
					$alerts.success language.Generic.StatReports.kIndicatorGroupAdded
					$scope.editGroup = _.extend $scope.editGroup, response.data
					$uibModalInstance.close($scope.editGroup)
				.catch (response) -> $errorHandler.responseHandler response
			cancel: ->
				$uibModalInstance.dismiss('cancel')
			$errorHandler: $errorHandler
		return
)
.controller('EmIndicators.EditGroup.SelectPredefined', 
	($scope, $uibModalInstance, $alerts, selected, predefinedIndicators, $errorHandler) ->
		$.extend $scope,
			language: language
			model:
				predefinedIndicators: predefinedIndicators
				selected: selected

			ok: (form) ->
				$uibModalInstance.close $scope.model.selected
			cancel: ->
				$uibModalInstance.dismiss 'cancel'
			$errorHandler: $errorHandler
		
		if !selected
			$scope.model.selected = predefinedIndicators[0]
		return
)
.controller('Em.Indicators.EditIndicator.EnterParamValues',
	($scope, $uibModalInstance, $errorHandler, $alerts, calculator) ->
		$errorHandler.errorList = []
		
		$.extend $scope,
			parameters: _.map(calculator.parameters, (parameter) ->
															if not parameter.value
																parameter.value = null
															parameter) 
			calculator: calculator
			$errorHandler: $errorHandler
			language: language
			cancel: ->
				$uibModalInstance.dismiss('cancel');
			ok: ->
				if $scope.fillParameterValues.$invalid
					$alerts.error language.Generic.StatReports.kEnteredIncorrectData, language.Generic.StatReports.kEnterCorrectDataInRedFields
					return
				$uibModalInstance.close($scope.parameters);
		return
)
.controller('Em.Indicators.EditIndicator.EditExplanation',
	($scope, $uibModalInstance, $alerts, indicatorExplanation) ->
		$scope.model = 
			indicatorExplanation: indicatorExplanation
		
		$.extend $scope,
			language: language
			cancel: ->
				$uibModalInstance.dismiss('cancel')
			ok: ->
				$uibModalInstance.close($scope.model.indicatorExplanation)
		return
)


