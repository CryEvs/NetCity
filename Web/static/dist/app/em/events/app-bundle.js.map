'use strict'

references = require "./references.coffee"

#модель представления мероприятия
export class EventOrgModel
	constructor: (dto) ->
		@dto = dto
		if dto
			@school = dto.school
			@educManagement = dto.educManagement
			@other = dto.other
			@name = dto.school?.name or dto.educManagement?.name or dto.other
		else
			@name = " - "

#модель представления мероприятия
export class EventViewModel
	constructor: (dto) ->
		@dto = dto
		@id = dto.id
		@name = dto.name
		@description = dto.description
		@founder = new EventOrgModel(dto.founder)
		@place = new EventOrgModel(dto.organization)
		@deleted = dto.deleted
		@subject = dto.subject
		@_globalYearId = dto.globalYearId

		if @dto.deleted
			@name += " (отменено)"

		if dto.partForm
			@partForm = references.participiationForms.indexer[dto.partForm]

		if dto.visitForm
			@visitForm = references.visitForms.indexer[dto.visitForm]

		if dto.level
			@level = references.eventLevels.indexer[dto.level].name

		@awardEventType = references.awardEventTypes.indexer[dto.awardEventType]
			
		@startTime = dateUtils.asUTCDate dateUtils.getLocalDateTime dto.startTime
		@date = dateUtils.date2str @startTime
					
		if dto.endTime and dto.endTime != dto.startTime
			@endTime = dateUtils.asUTCDate dateUtils.getLocalDateTime dto.endTime
			@date += " - " + dateUtils.date2str @endTime

		@curatorId = dto.curatorId
		@curator = dto.curator

		@personalEvent = (@curatorId is parseInt appContext.userId)
		return

	getStatus: () ->
		if (@endTime or @startTime) <= new Date()
			return "Ended"
		if (@startTime) >= new Date()
			return "Future"

#модель представления результатов участия в мероприятии
export class EventResultsViewModel
	constructor: (dto) ->
		@dto = dto

		@specialNotes = dto.specialNotes
		@results = []
		if dto.title
			@title = references.eventMemberTitles.indexer[dto.title]
			@results.push {type: "Итог", item: @title.name}
		if dto.rank
			@rank = dto.rank
			@results.push {type: "Место/рейтинг", item: @rank}
		if dto.sportTitle
			@sportTitle = references.sportTitles.indexer[dto.sportTitle]
			@results.push {type: "Спортивное звание", item: @sportTitle.name}
		if dto.sportCategory
			@sportCategory = references.sportCategories.indexer[dto.sportCategory]
			@results.push {type: "Спортивный разряд", item: @sportCategory.name}

#модель представления мероприятия
export class EventMemberViewModel extends EventResultsViewModel
	constructor: (dto) ->
		super(dto)

		@id = dto.id
		@user = dto.user
		@user.birthDate = date2str(new Date(@user.birthDate))

		@organization = dto.organization
		return

export class UserEventViewModel
	constructor: (@dto) ->
		@eventMemberId = @dto.eventMemberId
		@eventInfo = new EventViewModel(@dto.eventInfo)
		@participiationInfo = new EventResultsViewModel(@dto.participiationInfo)
		@curator = @dto.curator

		if @curator
			@curator.info = []
			@curator.info.push {title: "ФИО", text: @curator.fio}
			if @curator.position
				@curator.info.push {title: "Должность", text: @curator.position}
			if @curator.contacts
				@curator.info.push {title: "Контактная информация", text: @curator.contacts}
			
		return



