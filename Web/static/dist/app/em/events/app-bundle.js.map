'use strict';

import Selectable from "approot/global/selectable";
import * as Rights from "approot/global/references/rights.js";
import references from "./../common/references.coffee";
import { EventViewModel, EventOrgModel } from "./../common/model.coffee";

angular.module 'irtech.netcity.em.events'
.controller 'EventListCtrl', ($scope, pageContext, $http, $document, $alerts, $uibModal, $longWork, $dialogs, $q, $appLoader, $location, settingsProvider) ->
	pageContext.title = language.Generic.MenuFolders.kFEOEvents;
	pageContext.back = null;
	pageContext.parent = null;

	settingsProvider.ServerSettings.SystemSettings.IsRegionEMForSchool().then (val) -> if val then $scope.state.readOnly = true

	$.extend $scope,
		language: language
		state:
			viewReady: false
			dataReady: false
			emptyData: false
			readOnly: !_.contains(context.rights, Rights.arEMEventsEdit)
			accessToMembers: _.contains(context.rights, Rights.arEMEventsMembersView) || _.contains(context.rights, Rights.arEMEventsMembersEdit)
		data:
			refs: references
			year: null
			awardEventType: {id: ""}
			eventLevel: {id: ""}
			eventPlaceOwnType: id: "others"
			eventFounderOwnType: id: "own"
			events: []
			years: []
			filter:
				place: null
				founder: null
		search:
			place: null
			founder: null
			name: '',
			showPrivateEvents: false
		paging:
			page: 1
			pageSize: 50
			totalRows: 0
			totalPages: 1

	$scope.data.selection = new Selectable()

	defaultErrHandler = (response) ->
		if response?.data
			$.show.error response.data.message || language.Generic.Common.kErrorMsg
		else
			$.show.error language.Generic.Common.kErrorMsg

	loader =
		getYears: () -> return $http.get("/webapi/em/years").catch(defaultErrHandler)
		getEvents: (yearId, level, awardEventType, place, founder, name, showPrivateEvents) ->
			params = {
				yearId,
				level,
				awardEventType,
				name,
				placeSchoolId: place?.school?.id,
				placeEmId: place?.educManagement?.id,
				orgSchoolId: founder?.school?.id,
				orgEmId: founder?.educManagement?.id,
				page: $scope.paging.page,
				pageSize: $scope.paging.pageSeize,
				showPrivateEvents: showPrivateEvents
			}
			$http.get("/webapi/events/paged/awardevents/", {params}).catch(defaultErrHandler)
		getFounders: (yearId, level, awardEventType, showPrivateEvents) ->
			params = {
				yearId,
				level,
				awardEventType,
				showPrivateEvents
			}
			$http.get("/webapi/events/awardevents/organizations", {params}).catch(defaultErrHandler)
		getPlaces: (yearId, level, awardEventType, showPrivateEvents) ->
			params = {
				yearId,
				level,
				awardEventType,
				showPrivateEvents
			}
			$http.get("/webapi/events/awardevents/places", {params}).catch(defaultErrHandler)

	yearsLoaded = loader.getYears()
		.then (response) ->
			$scope.data.years = response.data
			if $scope.data.year is null
				$scope.data.year = _.first $scope.data.years
	$scope.throttleInstance = null

	$scope.throttleLoad = () ->
		if ($scope.throttleInstance)
			clearTimeout($scope.throttleInstance)
		$scope.throttleInstance = setTimeout($scope.load, 750)

	$scope.digestLoad = () ->
		$scope.state.dataReady = false
		$scope.data.selection.dropSelect()

		getItems = (elements) ->
			hashArray = []
			value = (obj) ->
				organization = obj.educManagement || obj.school
				return organization && organization.id || obj.name
			filter = (o) ->
				hash = value(o)
				result = hashArray.indexOf(hash) < 0
				if result
					hashArray.push hash
				return result
			return _.chain(elements).map((o) -> new EventOrgModel(o)).filter(filter).toArray().uniq().value()
		addDefaultVariants = (array) ->
			array.unshift
				id: 'other'
				name: 'Другие организации'
			array.unshift
				id: 'all'
				name: 'Все'

		loader.getFounders $scope.data.year.id, $scope.data.eventLevel?.id, $scope.data.awardEventType?.id, $scope.search.showPrivateEvents
			.then (response) -> addDefaultVariants $scope.data.filter.founder = getItems(response.data)

		loader.getPlaces $scope.data.year.id, $scope.data.eventLevel?.id, $scope.data.awardEventType?.id, $scope.search.showPrivateEvents
			.then (response) -> addDefaultVariants $scope.data.filter.place = getItems(response.data)

	$scope.pageLoad = () ->
		loader.getEvents $scope.data.year.id, $scope.data.eventLevel?.id, $scope.data.awardEventType?.id, $scope.search.place, $scope.search.founder, $scope.search.name, $scope.search.showPrivateEvents
			.then (response) ->
				result = response.data
				$scope.paging = {
					page: result.page,
					pageSize: result.pageSize,
					totalRows: result.totalRows,
					totalPages: Math.ceil(result.totalRows / result.pageSize)
				}
				$scope.data.events = _.map result.data, (dto) -> new EventViewModel dto
				$scope.state.emptyData = !$scope.data.events.length
				$appLoader.hide();
				$scope.state.dataReady = true

	#загрузка событий
	$scope.load = () ->
		$scope.digestLoad()
		$scope.pageLoad()

	$scope.add = () ->
		bodyRef = angular.element( $document[0].body )
		bodyRef.addClass('ovh')
		modalInstance = $uibModal.open
			templateUrl: '/static/dist/app/em/events/common/editEvent/template.html'
			controller: 'EditEventCtrl'
			size: "lg"
			resolve:
				model: ->
					event:
						id: 0
						organization: {}
						startTime: new Date()
						globalYearId: $scope.data.year.id
					educYears: $scope.data.years
					refs: $scope.data.refs

		modalInstance.result.then ->
			bodyRef.removeClass 'ovh'
			$scope.load()
		return

	$scope.edit = (event) ->
		modalInstance = $uibModal.open
			templateUrl: '/static/dist/app/em/events/common/editEvent/template.html'
			controller: 'EditEventCtrl'
			size: "lg"
			resolve:
				model: ->
					event: event.dto
					refs: $scope.data.refs
					educYears: $scope.data.years
		modalInstance.result.then -> $scope.load()
		return

	$scope.eventMembers = (event) ->
		$location.path("/#{event.id}/members")

	$scope.delete = (event) ->
		$dialogs.confirm "В случае продолжения будут удалено выбранное мероприятие а также данные об участниках данного мероприятия.\nВы желаете продолжить?"
			.then ->
				$http.delete "/webapi/events/", {params: eventId: event.id}
					.then () ->
						$alerts.success "Мероприятие успешно удалено"
						$scope.load()

	$scope.groupOrgs = (item) ->
		id = getItemId(item)
		if id == 'all' || id == 'other'
			return null
		if id != appContext.emId
			return 'Другие организации'
		return null

	getItemId = (item) ->
		organization = item.educManagement || item.school
		return organization && organization.id || item.id || item.name

	#Загрузка страницы
	$q.all([yearsLoaded]).then () ->
		$scope.state.viewReady = true
		do $scope.load

	return



