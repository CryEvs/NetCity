#angular = require 'angular'
module = angular.module 'irtech.netcity.em.events', [
	'ngRoute', 'ngSanitize', 'ngMessages', 'ui.select', 'uikit.alerts', 'uikit.dialogs', 'ui.bootstrap', 
	"irtech.netcity.common", "irtech.netcity.ui-components", 'irtech.netcity.em.events.common',
	"irtech.netcity.directive", "irtech.common.fileAttachment"
]

require("./common/references.coffee");
require("./list/eventListCtrl.coffee");
require("./common/eventMember/editEventMemberCtrl.js");
require("./common/editEvent/editEventCtrl.js");
require("./common/fileAttachment/controller.js");

require("approot/global/directives/storageDirective.coffee");

import { MemberListCtrl } from "./common/memberList/memberListCtrl.js";
import { EventMemebersComponent } from "./common/components/eventMembers.component.ts";

module
.component("eventMembersComponent", EventMemebersComponent)
.controller("MemberListCtrl", MemberListCtrl)
.config ($routeProvider, $locationProvider) ->
	$routeProvider
		.when("/:eventId/members", {
			templateUrl: "/static/dist/app/em/events/common/memberList/template.html"
			controller: "MemberListCtrl as ctrl"
		})
		.otherwise
			redirectTo: '/'
			templateUrl: '/static/dist/app/em/events/list/template.html'
			controller: 'EventListCtrl'
		

	$locationProvider.html5Mode(true);



