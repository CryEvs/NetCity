strWho = "Ученики"
strWhom1 = "ученика и его родителей"
strWhom = "учеников и родителей"
%>
<html lang="ru"><head>
<title>Пакетное обновление данных об учащихся</title>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
