<script LANGUAGE="VBScript" RUNAT="Server" SRC="/asp/scripts/upload_inc.asp"></script>
<script LANGUAGE="VBScript" RUNAT="Server" SRC="/asp/scripts/init.asp"></script>
<script LANGUAGE="VBScript" RUNAT="Server" SRC="/asp/scripts/AppFlags.asp"></script>
<script LANGUAGE="VBScript" RUNAT="Server" SRC="/asp/scripts/Constants.asp"></script>

<script LANGUAGE="VBScript" RUNAT="Server">
' © 2007-2022 IRTech. All rights reserved.

Const strFbProvider="Provider=LCPI.IBProvider;Data Source="
Const strMSSQLProvider="Provider=SQLOLEDB;"

Sub Application_OnStart
	Call obComponentMgr.Init()
	Call obConfig.StaticInstance.Init(Server.MapPath("\"), True)
	Application("MSSQL") = "1"
	Application("NS_VERSION") = "5.14"
	Application("NS_VERSION_DATE") = "21.02.2023"
	Application("NS_REVISION") = "65351"
	Application("NS_PRODUCT_NAME") = "Сетевой Город. Образование"
	Application("NS_COPYRIGHT") = "&copy; 2007-2023 ИРТех"
	Application("NS_COPYRIGHT2") = "г. Самара. Все права защищены"
	obTokenMgr.Application()("NS_PRODUCT_NAME") = Application("NS_PRODUCT_NAME")
	Dim strDbProvider

  Application("IsCollege") = False
  Application("SERVER_HOSTNAME") = "NET_SCHOOL:80"

	obTokenMgr.Application()("MAX_HEAVY_SESSIONS") = 5
	Application("WEB_INSTANCE_ID") = ""

	Application("KLADRFolder") = obConfig.StaticInstance.DbPath & "\KLADR\"
	Application("NS_FILES_PATH") = obConfig.StaticInstance.DbPath

	strDbProvider = strMSSQLProvider

	Application("DB_STRING") = strDbProvider & obConfig.StaticInstance.DbConfiguration.WorkConnection
	Application("DB_STRING_ARCH") = strDbProvider & obConfig.StaticInstance.DbConfiguration.ArchConnection
	Application("CONNECTION_STRING") = Application("DB_STRING")

	Application("LASTGRADE") = Array(0,8,12,12,12)

	If Application("IsCollege") Then
		obLanguage.FixedFunctionality = FuncType_ProfSchool
	End If
	Call RegisterComponents()
	Call InitConstants()
	Call InitUploadLimits()
	Application("APP_EVENTS_HOOK") = Server.CreateObject("NetCity.Common.Legacy.Hooks.AppEventsHook")
End Sub

Sub Session_OnStart
End Sub

Sub Session_OnEnd
End Sub

</script>
