# =====================================================================
# NetCity 5.14 — установочный каталог + реконструкция БД
# =====================================================================
CLAUDE.MD
# ---------------------------------------------------------------------
# Конфигурации с реальными паролями к БД.
# Чтобы добавить очищенную копию (пароль заменён, например, на ***):
#   git add -f <файл>
# ---------------------------------------------------------------------
ns.config
ns.config.original
Contingent.Agent/NetCity.Integration.Contingent.Agent.exe.config
MobileGate/Settings/IRTech.NetCity.Edu.Mobile.ClientService.Settings.exe.config
NetCity.Synchronize.Client.Service/NetCity.Synchronize.Client.Service.exe_old.config
Update/NetCity.Update.WCF.Client.exe.config
*.pfx
*.p12
*.snk
*.key
secrets.*
.env

# ---------------------------------------------------------------------
# Логи (могут содержать ФИО, логины, IP, запросы с данными)
# ---------------------------------------------------------------------
*.log
[Ll]ogs/
Contingent.Agent/!LogsAgent/
db_reverse/deploy/deploy-admin.log

# ---------------------------------------------------------------------
# Кеши и временные файлы продукта
# ---------------------------------------------------------------------
Assemblies/__cache/
Contingent.Agent/temp/
[Tt]emp/
[Tt]mp/

# ---------------------------------------------------------------------
# Базы данных и бэкапы
# ---------------------------------------------------------------------
*.bak
*.mdf
*.ldf
*.ndf
*.gdb
*.fdb
*.dump
*.rdb
dump.rdb

# ---------------------------------------------------------------------
# Инструменты реконструкции: результаты сборки и декомпиляции
# (декомпилированный код ИрТех не публикуется)
# ---------------------------------------------------------------------
db_reverse/tools/*.exe
db_reverse/tools/*.pdb
db_reverse/tools/bin/
db_reverse/tools/obj/
decompiled/
dec/
__pycache__/
*.pyc

# ---------------------------------------------------------------------
# Среда разработки и ОС
# ---------------------------------------------------------------------
.vs/
.vscode/
.idea/
.claude/
*.suo
*.user
Thumbs.db
Desktop.ini
.DS_Store
